+// applyAdmissionToSummaryRequest admits a compaction summary request against
+// the shared-window budget without clipping its fixed output budget. A digest
+// must be able to emit its full output; the provider itself decides the real
+// capacity. Only a physically impossible shared window (admitOutputBudget
+// already reports ErrCompactionRequired) rejects the summary upfront.
+func (a *Agent) applyAdmissionToSummaryRequest(req *provider.Request) error {
+	if a == nil || req == nil {
+		return nil
+	}
+	_, err := a.admitOutputBudget(*req)
+	if err != nil {
+		return err
+	}
+	return nil
+}
