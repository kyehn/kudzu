+// learnConfiguredWindowFromContextLimit records the window of a trusted
+// shared-window overflow. The gateway's explicit window wins over the
+// configured one — a provider can prove more headroom than a conservative
+// config (e.g. 200000 configured vs 1048576 reported) — and only when the
+// body yields no window at all do we fall back to the configured value.
+// Unlike learnContextBudget it may raise the learned window, because a
+// stale small observation must not permanently cap the real capacity.
+func (a *Agent) learnConfiguredWindowFromContextLimit(limit *provider.ContextLimitError, omitted bool) {
+	if a == nil || limit == nil {
+		return
+	}
+	window := limit.WindowTokens
+	if window <= 0 {
+		window = a.contextWindow
+	}
+	if window <= 0 {
+		return
+	}
+	cur := learnedContextBudget{}
+	if prev := a.sess.output.learned.Load(); prev != nil {
+		cur = *prev
+	}
+	cur.windowTokens = window
+	if omitted && limit.CompletionTokens > 0 {
+		cur.completionBudget = limit.CompletionTokens
+	}
+	a.sess.output.learned.Store(&cur)
+}
