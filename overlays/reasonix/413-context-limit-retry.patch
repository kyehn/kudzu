+
+// The compaction summarizer must be able to emit its full digest. A small
+// configured window must not clip the summary's fixed output budget once the
+// gateway proves it has more headroom.
+func TestApplyAdmissionToSummaryRequestKeepsFixedOutputBudget(t *testing.T) {
+	prov := &sharedWindowTestProvider{budget: 128 * 1024, shared: true}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 100_000},
+		svc:         agentServices{prov: prov, sink: event.Discard},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: prov.budget}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("字", 50_000)}}
+	a.sess.output.lastUsage.Store(&provider.Usage{PromptTokens: 50_000})
+	a.setPromptTokenCalibration(50_000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	req := provider.Request{Messages: msgs, MaxTokens: summaryOutputMaxTokens}
+	if err := a.applyAdmissionToSummaryRequest(&req); err != nil {
+		t.Fatalf("summary admission: %v", err)
+	}
+	if req.MaxTokens != summaryOutputMaxTokens {
+		t.Fatalf("summary MaxTokens = %d, want fixed %d (unclipped)", req.MaxTokens, summaryOutputMaxTokens)
+	}
+}
+
+// Physical impossibility (no shared-window room at all) still requires
+// compaction, exactly like the ordinary request path.
+func TestApplyAdmissionToSummaryRequestRequiresPhysicalRoom(t *testing.T) {
+	prov := &sharedWindowTestProvider{budget: 128 * 1024, shared: true}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 100_000},
+		svc:         agentServices{prov: prov, sink: event.Discard},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: prov.budget}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("字", 95_000)}}
+	a.sess.output.lastUsage.Store(&provider.Usage{PromptTokens: 95_000})
+	a.setPromptTokenCalibration(95_000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	req := provider.Request{Messages: msgs, MaxTokens: summaryOutputMaxTokens}
+	if err := a.applyAdmissionToSummaryRequest(&req); !errors.Is(err, ErrCompactionRequired) {
+		t.Fatalf("summary admission err = %v, want ErrCompactionRequired", err)
+	}
+}
+
+// A gateway-reported window larger than the conservative configured one must
+// drive the physical budget; the reported window stays for display only.
+func TestAdmitOutputBudgetUsesObservedWindowWhenLarger(t *testing.T) {
+	prov := &sharedWindowTestProvider{budget: 128 * 1024, shared: true}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 200_000},
+		svc:         agentServices{prov: prov},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: prov.budget}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("x", 600_000)}}
+	a.setPromptTokenCalibration(100_000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	// The gateway proved a 1M window; the configured 200k must not starve output.
+	a.sess.output.learned.Store(&learnedContextBudget{windowTokens: 1_048_576})
+	adm, err := a.admitOutputBudget(provider.Request{Messages: msgs, MaxTokens: 1_000_000})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if adm.PromptTokens < 99_000 || adm.PromptTokens > 101_000 {
+		t.Fatalf("calibrated prompt = %d, want ~100000", adm.PromptTokens)
+	}
+	wantPhysical := 1_048_576 - adm.PromptTokens - outputBudgetReserve
+	if adm.PhysicalRemaining != wantPhysical {
+		t.Fatalf("physical = %d, want %d (observed window, not configured 200k)", adm.PhysicalRemaining, wantPhysical)
+	}
+	if adm.WindowTokens != 200_000 {
+		t.Fatalf("reported window = %d, want configured 200000", adm.WindowTokens)
+	}
+	// The provider's own 131072 output cap must fit inside the observed 1M
+	// window untouched. Under the configured 200k window it would be clipped
+	// to ~91808, so no clipping here proves the observed window drives the
+	// physical budget.
+	if adm.Clipped {
+		t.Fatalf("provider cap must fit the observed 1M window, got clipped: %+v", adm)
+	}
+	if adm.EffectiveOutputTokens != 131_072 {
+		t.Fatalf("effective = %d, want provider cap 131072", adm.EffectiveOutputTokens)
+	}
+}
+
+// The gateway's explicit window wins over the configured one and may raise a
+// stale learned window; only a body with no window falls back to the config.
+func TestLearnConfiguredWindowFromContextLimitParsedWins(t *testing.T) {
+	a := &Agent{agentConfig: agentConfig{contextWindow: 200_000}}
+	limit := &provider.ContextLimitError{WindowTokens: 1_048_576, CompletionTokens: 354_469}
+	a.learnConfiguredWindowFromContextLimit(limit, true)
+	if got := a.effectiveContextWindow(); got != 200_000 {
+		t.Fatalf("effective window = %d, want configured 200000 (conservative display)", got)
+	}
+	if snap := a.sess.output.learned.Load(); snap == nil || snap.windowTokens != 1_048_576 || snap.completionBudget != 354_469 {
+		t.Fatalf("learned = %+v, want window 1048576 completion 354469", snap)
+	}
+	// The observed completion budget only counts when output was omitted.
+	a.learnConfiguredWindowFromContextLimit(&provider.ContextLimitError{WindowTokens: 512_000, CompletionTokens: 99_000}, false)
+	if snap := a.sess.output.learned.Load(); snap == nil || snap.windowTokens != 512_000 || snap.completionBudget != 354_469 {
+		t.Fatalf("learned = %+v, want window 512000 completion still 354469", snap)
+	}
+}
+
+func TestLearnConfiguredWindowFromContextLimitFallsBackToConfig(t *testing.T) {
+	a := &Agent{agentConfig: agentConfig{contextWindow: 200_000}}
+	a.learnConfiguredWindowFromContextLimit(&provider.ContextLimitError{}, false)
+	if snap := a.sess.output.learned.Load(); snap == nil || snap.windowTokens != 200_000 {
+		t.Fatalf("learned = %+v, want configured fallback 200000", snap)
+	}
+}
