+func TestParseContextLimitErrorLongerFormat(t *testing.T) {
+	// OpenAI-compatible gateways report a bare input-vs-window comparison.
+	text := "The input (1165351 tokens) is longer than the model's context length (1048576 tokens)"
+	got := ParseContextLimitError(&APIError{Status: 400, Body: text})
+	if got == nil || got.WindowTokens != 1_048_576 || got.PromptTokens != 1_165_351 || got.RequestedTokens != 1_165_351 || got.CompletionTokens != 0 {
+		t.Fatalf("longer-format parse = %+v", got)
+	}
+	// The same text inside a JSON error message must also parse.
+	jsonBody := `{"error":{"message":"The input (1165351 tokens) is longer than the model's context length (1048576 tokens)"}}`
+	got = ParseContextLimitError(&APIError{Status: 400, Body: jsonBody})
+	if got == nil || got.WindowTokens != 1_048_576 || got.PromptTokens != 1_165_351 {
+		t.Fatalf("longer-format json parse = %+v", got)
+	}
+	// input <= window is not an overflow and must stay unparsed.
+	if ParseContextLimitError(&APIError{Status: 400, Body: "The input (1048576 tokens) is longer than the model's context length (2000000 tokens)"}) != nil {
+		t.Fatal("input <= window must be rejected")
+	}
+}
