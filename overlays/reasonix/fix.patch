+package agent
+
+import (
+	"strings"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+func TestSummaryRequestForcesNoReasoning(t *testing.T) {
+	a := &Agent{agentConfig: agentConfig{contextWindow: 100_000, maxOutputTokens: 20_000, compactRatio: 0.85}}
+	region := []provider.Message{
+		{Role: provider.RoleSystem, Content: "sys"},
+		{Role: provider.RoleUser, Content: strings.Repeat("work output ", 200)},
+	}
+
+	req := a.summaryRequest(region, "")
+	if !req.NoReasoning {
+		t.Fatalf("summaryRequest must force NoReasoning on the wire request: %+v", req)
+	}
+	if req.MaxTokens != summaryOutputMaxTokens {
+		t.Fatalf("summary output budget = %d, want %d", req.MaxTokens, summaryOutputMaxTokens)
+	}
+	last := req.Messages[len(req.Messages)-1]
+	if last.Role != provider.RoleUser || last.Content == "" {
+		t.Fatalf("summary request must end with the compaction instruction user turn, got %q/%q", last.Role, last.Content)
+	}
+	if !strings.Contains(last.Content, compactionInstruction[0:min(24, len(compactionInstruction))]) {
+		t.Fatalf("summary tail must carry the compaction instruction, got %q", last.Content)
+	}
+}
+
+func TestSummaryRequestNoReasoningIndependentOfConfiguredEffort(t *testing.T) {
+	// The flag is structural: even a client with thinking on by default gets
+	// the off wire once the agent builds the summary request. This test pins
+	// the agent→provider contract so a future effort-tunnel regression is
+	// caught at the agent boundary, not only in provider marshal tests.
+	a := &Agent{agentConfig: agentConfig{contextWindow: 100_000, maxOutputTokens: 20_000, compactRatio: 0.85}}
+	req := a.summaryRequest([]provider.Message{
+		{Role: provider.RoleSystem, Content: "sys"},
+		{Role: provider.RoleUser, Content: "task"},
+	}, "focus")
+	if !req.NoReasoning {
+		t.Fatalf("summaryRequest must set NoReasoning regardless of instructions: %+v", req)
+	}
+}
