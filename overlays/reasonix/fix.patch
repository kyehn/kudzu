diff --git a/internal/provider/responses/opencode_summary_test.go b/internal/provider/responses/opencode_summary_test.go
new file mode 100644
index 0000000..e1c8602
--- /dev/null
+++ b/internal/provider/responses/opencode_summary_test.go
@@ -0,0 +1,124 @@
+package responses
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// muse-spark encrypts raw reasoning: the Console returns visible thinking
+// only when the request asks for a summary (live-probed 2026-09-05: effort
+// alone yields encrypted_content with an empty summary list and no
+// reasoning_summary deltas; summary:auto streams them). These tests pin the
+// opencode request shape and the stateless replay rule (prior-turn ids are
+// unresolvable without previous_response_id: 400 "not found or has expired").
+
+func TestOpencodeReasoningRequestsSummary(t *testing.T) {
+	client := New(Config{Name: "opencode-responses", BaseURL: "https://opencode.ai/zen/v1", Model: "muse-spark-1.3-contributor-free", Effort: "xhigh"}).(*client)
+	body, _, _ := client.buildRequestBody(provider.Request{Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}}})
+	reasoning, ok := body["reasoning"].(map[string]any)
+	if !ok {
+		t.Fatalf("reasoning missing: %#v", body)
+	}
+	if reasoning["effort"] != "xhigh" || reasoning["summary"] != "auto" {
+		t.Fatalf("reasoning = %#v, want {effort:xhigh summary:auto}", reasoning)
+	}
+	include, ok := body["include"].([]string)
+	if !ok || len(include) != 1 || include[0] != "reasoning.encrypted_content" {
+		t.Fatalf("include = %#v, want [reasoning.encrypted_content]", body["include"])
+	}
+}
+
+func TestNonOpencodeReasoningUnchanged(t *testing.T) {
+	client := New(Config{Name: "deepseek", BaseURL: "https://api.deepseek.com", Model: "deepseek-v4-flash", Effort: "high"}).(*client)
+	body, _, _ := client.buildRequestBody(provider.Request{Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}}})
+	reasoning, ok := body["reasoning"].(map[string]any)
+	if !ok {
+		t.Fatalf("reasoning missing: %#v", body)
+	}
+	if len(reasoning) != 1 || reasoning["effort"] != "high" {
+		t.Fatalf("reasoning = %#v, want effort-only", reasoning)
+	}
+	if _, ok := body["include"]; ok {
+		t.Fatalf("include leaked to non-opencode request: %#v", body)
+	}
+}
+
+func TestOpencodeNoEffortSendsNoReasoning(t *testing.T) {
+	client := New(Config{Name: "opencode-responses", BaseURL: "https://opencode.ai/zen/v1", Model: "muse-spark-1.3-contributor-free"}).(*client)
+	body, _, _ := client.buildRequestBody(provider.Request{Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}}})
+	if _, ok := body["reasoning"]; ok {
+		t.Fatalf("reasoning sent without effort: %#v", body)
+	}
+}
+
+func replayFixture() []provider.Message {
+	return []provider.Message{
+		{Role: provider.RoleUser, Content: "first"},
+		{Role: provider.RoleAssistant, Content: "answer", ReasoningContent: "think", ReasoningID: "rs_prior", ReasoningStatus: "completed"},
+		{Role: provider.RoleUser, Content: "second"},
+	}
+}
+
+func findReasoningItem(t *testing.T, body map[string]any) map[string]any {
+	t.Helper()
+	items, ok := body["input"].([]map[string]any)
+	if !ok {
+		t.Fatalf("input = %#v", body["input"])
+	}
+	for _, item := range items {
+		if item["type"] == "reasoning" {
+			return item
+		}
+	}
+	t.Fatalf("no reasoning item in %#v", items)
+	return nil
+}
+
+func TestStatelessReplayOmitsReasoningID(t *testing.T) {
+	client := New(Config{Name: "opencode-responses", BaseURL: "https://opencode.ai/zen/v1", Model: "muse-spark-1.3-contributor-free", Mode: "stateless", Effort: "xhigh"}).(*client)
+	body, _, _ := client.buildRequestBody(provider.Request{Messages: replayFixture()})
+	item := findReasoningItem(t, body)
+	if _, ok := item["id"]; ok {
+		t.Fatalf("stateless replay must omit reasoning id: %#v", item)
+	}
+	if item["summary"] == nil {
+		t.Fatalf("stateless replay must keep summary: %#v", item)
+	}
+}
+
+func TestStatefulReplayKeepsReasoningID(t *testing.T) {
+	client := New(Config{Name: "opencode-responses", BaseURL: "https://opencode.ai/zen/v1", Model: "muse-spark-1.3-contributor-free", Mode: "stateful", Effort: "xhigh"}).(*client)
+	body, _, _ := client.buildRequestBody(provider.Request{Messages: replayFixture()})
+	item := findReasoningItem(t, body)
+	if item["id"] != "rs_prior" {
+		t.Fatalf("stateful replay must keep reasoning id: %#v", item)
+	}
+}
+
+func TestSummaryDeltasStreamAsReasoningChunks(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		writeEvents(w,
+			`{"type":"response.output_item.added","item":{"id":"rs_1","type":"reasoning"}}`,
+			`{"type":"response.reasoning_summary_text.delta","item_id":"rs_1","content_index":0,"delta":"summarizing"}`,
+			`{"type":"response.reasoning_summary_text.done","item_id":"rs_1","content_index":0,"text":"summarizing"}`,
+			`{"type":"response.output_text.delta","item_id":"msg_1","content_index":0,"delta":"hi"}`,
+			`{"type":"response.completed","response":{"id":"resp_1","usage":{"input_tokens":10,"output_tokens":4,"total_tokens":14}}}`,
+		)
+	}))
+	defer server.Close()
+
+	p := New(Config{Name: "opencode-responses", APIKey: "key", BaseURL: server.URL, Model: "muse-spark", Mode: "stateless", Effort: "xhigh"})
+	chunks := collect(t, p, provider.Request{Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}}})
+	var reasoning string
+	for _, chunk := range chunks {
+		if chunk.Type == provider.ChunkReasoning {
+			reasoning += chunk.Text
+		}
+	}
+	if reasoning != "summarizing" {
+		t.Fatalf("reasoning chunks = %q, want %q", reasoning, "summarizing")
+	}
+}
