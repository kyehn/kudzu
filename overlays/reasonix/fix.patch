+	if !strings.Contains(on, `"thinking":{"type":"enabled"}`) {
+		t.Fatalf("deepseek default wire must enable thinking: %s", on)
+	}
+	if !strings.Contains(on, `"reasoning_effort":"high"`) {
+		t.Fatalf("deepseek default wire must carry reasoning_effort: %s", on)
+	}
+
+	off := marshalBuildRequest(t, c, provider.Request{Messages: msg, NoReasoning: true})
+	if !strings.Contains(off, `"thinking":{"type":"disabled"}`) {
+		t.Fatalf("deepseek NoReasoning must emit thinking.type=disabled: %s", off)
+	}
+	if strings.Contains(off, "reasoning_effort") {
