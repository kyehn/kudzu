+// IsOpenCode reports whether a provider speaks the opencode Zen wire shape.
+// The generated config always names the provider "opencode-zen" (and keeps that
+// name even when a local capture proxy rewrites base_url to an IP), so the name
+// alone is a reliable, option-free signal.
+func IsOpenCode(name, baseURL string) bool {
+	return strings.EqualFold(strings.TrimSpace(name), "opencode-zen")
+}
