+// globalContainer reports whether the text after a scope qualifier still
+// names the entire tree rather than a subtree of it.
+func globalContainer(rest string) bool {
+	return startsWithAnyWord(strings.TrimSpace(rest), []string{
+		"the workspace", "this workspace", "workspace",
+		"the repository", "this repository", "repository",
+		"the repo", "this repo", "repo",
+		"the codebase", "this codebase", "codebase",
+		"the project", "the source tree",
+	})
