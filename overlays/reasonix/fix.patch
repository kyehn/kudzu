+// isForeignEncryptedReasoningError reports the 400 a gateway returns when a
+// replayed reasoning item's encrypted_content was issued to a different
+// caller than the one serving this request.
+func isForeignEncryptedReasoningError(err error) bool {
+	var apiErr *provider.APIError
+	if !errors.As(err, &apiErr) || apiErr.Status != http.StatusBadRequest {
+		return false
+	}
+	body := strings.ToLower(apiErr.Body)
+	if !strings.Contains(body, "encrypted_content") {
+		return false
+	}
+	return strings.Contains(body, "not issued") || strings.Contains(body, "caller")
+}
+
+// bodyWithoutEncryptedReasoning returns a copy of a Responses request body
+// with every replayed reasoning item's encrypted_content removed, or nil
+// when the body carries none. Plaintext summary/content survive, so the
+// replayed turn keeps its thinking without the issuer-bound opaque blob.
+func bodyWithoutEncryptedReasoning(body map[string]any) map[string]any {
+	input, ok := body["input"].([]map[string]any)
+	if !ok {
+		return nil
+	}
+	stripped := false
+	next := make([]map[string]any, len(input))
+	for i, item := range input {
+		if item["type"] == "reasoning" {
+			if _, has := item["encrypted_content"]; has {
+				cp := make(map[string]any, len(item))
+				for k, v := range item {
+					if k != "encrypted_content" {
+						cp[k] = v
+					}
+				}
+				item = cp
+				stripped = true
+			}
+		}
+		next[i] = item
+	}
+	if !stripped {
+		return nil
+	}
+	out := make(map[string]any, len(body))
+	for k, v := range body {
