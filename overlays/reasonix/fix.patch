+	}
+}
+
+// zenDeepSeekPolicyProvider simulates the patched openCodeZenDeepSeek policy:
+// shared-window budget with zero AutoOutputTokens so the gateway never sees
+// an auto-budget that becomes an oversized max_tokens on the wire.
+type zenDeepSeekPolicyProvider struct{}
+
+func (zenDeepSeekPolicyProvider) Name() string { return "opencode-zen" }
+func (zenDeepSeekPolicyProvider) Stream(_ context.Context, _ provider.Request) (<-chan provider.Chunk, error) {
+	ch := make(chan provider.Chunk, 1)
+	close(ch)
+	return ch, nil
+}
+func (zenDeepSeekPolicyProvider) ContextBudgetPolicy() provider.ContextBudgetPolicy {
+	return provider.ContextBudgetPolicy{
+		WindowMode: provider.ContextWindowShared,
+		LimitMode:  provider.OutputLimitOmitWhenSafe,
+		// AutoOutputTokens and MaxOutputTokens deliberately zero: the Zen
+		// gateway does not understand DeepSeek's native omit-for-default
+		// semantics, so any auto budget that survives into a physical clip
+		// would become an explicit max_tokens the gateway rejects.
