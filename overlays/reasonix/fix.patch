+)
+
+func TestZenAnthropicCarriesCLIIdentity(t *testing.T) {
+	var headers http.Header
+	var body struct {
+		Tools []struct {
+			Name string `json:"name"`
+		} `json:"tools"`
+		Stream bool `json:"stream"`
+	}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		headers = r.Header.Clone()
+		_ = json.Unmarshal(raw, &body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, "data: {\"type\":\"message_stop\"}\n\n")
+	}))
+	t.Cleanup(srv.Close)
+
+	p, err := New(provider.Config{Name: "opencode", BaseURL: "https://opencode.ai/zen/v1", Model: "big-pickle", APIKey: "public"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	c := p.(*client)
+	if !c.opencode {
+		t.Fatalf("client for opencode/zen/v1 is not flagged opencode")
+	}
+	c.http = srv.Client()
+	// Keep the /v1/messages suffix so the User-Agent pin selects the
+	// anthropic identity, exactly like the derived production request URL.
+	c.requestURL = srv.URL + "/v1/messages"
+
+	ch, err := c.Stream(context.Background(), provider.Request{
+		Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}},
+		Tools:    []provider.ToolSchema{{Name: "read_file"}, {Name: "bash"}},
+	})
+	if err != nil {
+		t.Fatalf("Stream: %v", err)
+	}
+	for chunk := range ch {
+		if chunk.Type == provider.ChunkError {
+			t.Fatalf("stream error: %v", chunk.Err)
+		}
+	}
+	if got := headers.Get("User-Agent"); got != provider.OpenCodeUserAgentAnthropic {
+		t.Fatalf("User-Agent = %q, want %q", got, provider.OpenCodeUserAgentAnthropic)
+	}
+	if got := headers.Get("x-opencode-client"); got != "cli" {
+		t.Fatalf("x-opencode-client = %q, want cli", got)
+	}
+	if !strings.HasPrefix(headers.Get("x-opencode-session"), "ses_") {
+		t.Fatalf("x-opencode-session = %q, want ses_ prefix", headers.Get("x-opencode-session"))
+	}
+	if headers.Get("Authorization") != "" || headers.Get("x-api-key") != "" {
+		t.Fatalf("auth headers = %q/%q, want empty for anonymous zen",
+			headers.Get("Authorization"), headers.Get("x-api-key"))
+	}
+	if len(body.Tools) != 2 || body.Tools[0].Name != "read" || body.Tools[1].Name != "bash" {
+		t.Fatalf("wire tool names = %+v, want [read bash]", body.Tools)
+	}
+	// Non-opencode endpoints keep the default auth + identity behavior.
+	plain, err := New(provider.Config{Name: "relay", BaseURL: srv.URL, Model: "m", APIKey: "k"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if plain.(*client).opencode {
+		t.Fatalf("plain relay flagged opencode")
+	}
+}
