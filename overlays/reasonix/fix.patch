+import (
+	"compress/flate"
+	"compress/gzip"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"reasonix/internal/contract/provider"
+
+	"github.com/andybalholm/brotli"
+	"github.com/klauspost/compress/zstd"
+)
+
+// opencodeRename maps reasonix-native tool names to the opencode CLI names
+// the zen free-tier gate requires. Live-probed: the gate needs tools named
+// exactly `bash` and `read`; reasonix natively provides `bash` but reads via
+// `read_file`, so only that one is renamed. Extra tools are unaffected.
+var opencodeRename = map[string]string{"read_file": "read"}
+
+// ApplyOpencodeNames returns req with tools renamed to opencode CLI names
+// when talking to an opencode endpoint. Non-opencode providers pass through
+// untouched. Renaming (not aliasing) keeps exactly one entry per tool, so
+// the model can never call a name with no implementation.
+func ApplyOpencodeNames(name, baseURL string, req provider.Request) provider.Request {
+	if !provider.IsOpenCode(name, baseURL) {
+		return req
+	}
+	tools := make([]provider.ToolSchema, 0, len(req.Tools))
+	for _, t := range req.Tools {
+		if renamed, ok := opencodeRename[t.Name]; ok {
+			t.Name = renamed
+		}
+		tools = append(tools, t)
+	}
+	req.Tools = tools
+	return req
+}
+
+// applyOpenCodeHeaders stamps the shared opencode CLI identity onto a chat
+// request: one ses_ ID (and prompt_cache_key) is reused for the whole session
+// plus a fresh msg_ request ID per call, exactly like the CLI
+// (packages/opencode/src/session/llm/request.ts, v1.18.32).
+func (c *client) applyOpenCodeHeaders(h http.Header, targetURL string) {
+	if !c.opencode {
+		return
+	}
+	provider.ApplyOpenCodeCLIHeaders(h, c.openCodeSession, c.opencodeProject, targetURL)
+}
+
+// isZenHost reports the opencode Zen gateway (host-based IsOpenCode route).
+func isZenHost(baseURL string) bool {
+	u, err := url.Parse(baseURL)
+	if err != nil {
+		return false
+	}
+	host := strings.ToLower(u.Hostname())
+	if host == "zenmux.ai" || strings.HasSuffix(host, ".zenmux.ai") {
+		return true
+	}
+	return strings.Contains(u.EscapedPath(), "/zen/v1")
+}
+
+// decodedBody couples a Content-Encoding decoder with the underlying response
+// body. Codec Close methods (gzip/flate) do not close — nor unblock a blocked
+// Read on — the transport connection, so ownership of the raw body moves here:
+// closing the decoded body tears down the connection, which is what lets the
+// SSE stall watchdog and context cancellation always unblock scanner.Scan,
+// regardless of codec.
+type decodedBody struct {
+	io.Reader
+	decoder io.Closer // per-codec decoder; may be nil when GC-owned
+	raw     io.ReadCloser
+}
+
+func (d *decodedBody) Close() error {
+	if d.decoder != nil {
+		_ = d.decoder.Close()
+	}
+	return d.raw.Close()
+}
+
+// decompressBody unwraps the response body according to Content-Encoding.
+// Server may compress responses, so the SSE parser must decode manually.
+func decompressBody(resp *http.Response) (io.ReadCloser, error) {
+	raw := resp.Body
+	switch strings.ToLower(strings.TrimSpace(resp.Header.Get("Content-Encoding"))) {
+	case "gzip":
+		zr, err := gzip.NewReader(raw)
+		if err != nil {
+			raw.Close()
+			return nil, err
+		}
+		return &decodedBody{Reader: zr, decoder: zr, raw: raw}, nil
+	case "deflate":
+		fr := flate.NewReader(raw)
+		return &decodedBody{Reader: fr, decoder: fr, raw: raw}, nil
+	case "br":
+		return &decodedBody{Reader: brotli.NewReader(raw), raw: raw}, nil
+	case "zstd":
+		zr, err := zstd.NewReader(raw)
+		if err != nil {
+			raw.Close()
+			return nil, err
+		}
+		rc := zr.IOReadCloser()
+		return &decodedBody{Reader: rc, decoder: rc, raw: raw}, nil
+	default:
+		return raw, nil
+	}
+}
diff --git a/internal/model/openai/opencode_wire_test.go b/internal/model/openai/opencode_wire_test.go
