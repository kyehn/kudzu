diff --git a/internal/provider/openai/opencode.go b/internal/provider/openai/opencode.go
new file mode 100644
index 000000000..5b00c9d5f
--- /dev/null
+++ b/internal/provider/openai/opencode.go
@@ -0,0 +1,191 @@
+package openai
+
+import (
+	"compress/flate"
+	"compress/gzip"
+	"encoding/json"
+	"io"
+	"maps"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/andybalholm/brotli"
+	"github.com/klauspost/compress/zstd"
+)
+
+// Wire constants recaptured from the real opencode CLI (opencode2
+// v0.0.0-beta-19151, beta channel) so a reasonix request against an opencode
+// endpoint is indistinguishable from the CLI's. The v2 CLI sends no
+// per-request trace headers (b3/traceparent are observability noise the
+// server never requires) and no x-opencode-request.
+const (
+	opencodeUserAgent = "opencode/beta/0.0.0-beta-19151/cli"
+)
+
+// applyOpenCodeHeaders stamps the opencode-specific headers onto a request.
+// The x-opencode-* keys are written lowercase (like the real CLI) via direct
+// map assignment; Go writes header map keys verbatim, preserving the casing.
+// The session ID is fixed per client instance, exactly like the CLI reusing
+// one ses_ ID (and prompt_cache_key) for the whole session.
+func (c *client) applyOpenCodeHeaders(h http.Header) {
+	if !c.opencode {
+		return
+	}
+	// Drop canonical-cased copies a config may have supplied so the lowercase
+	// keys below are the only ones that reach the wire.
+	h.Del("User-Agent")
+	h.Del("X-Opencode-Client")
+	h.Del("X-Opencode-Session")
+	h.Del("X-Opencode-Project")
+	h.Del("X-Session-Affinity")
+	h.Del("X-Session-Id")
+	h.Set("User-Agent", opencodeUserAgent)
+	h["x-opencode-client"] = []string{"cli"}
+	h["x-opencode-project"] = []string{"global"}
+	h["x-opencode-session"] = []string{c.opencodeSession}
+	h["x-session-affinity"] = []string{c.opencodeSession}
+	h["x-session-id"] = []string{c.opencodeSession}
+}
+
+// openCodeOmitsStore mirrors openai-chat.ts detectSupportsStore(): the CLI
+// sends store:false only when the provider is NOT its own — i.e. a custom
+// name on a non-opencode.ai host (zenmux custom providers, local capture
+// proxies). The opencode provider itself omits store (like tool_choice and
+// temperature, dropped when unset). Live-probed 2026-09-05: the gateways
+// accept both shapes; this matches what the CLI actually emits per path.
+func openCodeOmitsStore(name, baseURL string) bool {
+	if strings.EqualFold(strings.TrimSpace(name), "opencode") {
+		return true
+	}
+	u, err := url.Parse(baseURL)
+	if err != nil {
+		return false
+	}
+	return strings.Contains(strings.ToLower(u.Hostname()), "opencode.ai")
+}
+
+// openCodeRequest emits the opencode body key order exactly as the CLI sends
+// it (openai-chat.ts fromRequest): model, messages, tools, tool_choice,
+// stream, stream_options, max_completion_tokens, temperature, store,
+// prompt_cache_key. Keys whose values are unset are dropped, exactly like the
+// CLI's JSON.stringify dropping undefined: no tool_choice or temperature by
+// default, max_completion_tokens only when a budget is configured (zen is not
+// in the legacy max_tokens list, so the CLI never sends max_tokens here),
+// and store only on non-opencode providers (see openCodeOmitsStore).
+type openCodeRequest struct {
+	Model               string         `json:"model"`
+	Messages            []chatMessage  `json:"messages"`
+	Tools               []chatTool     `json:"tools,omitempty"`
+	ToolChoice          string         `json:"tool_choice,omitempty"`
+	Stream              bool           `json:"stream"`
+	StreamOptions       *streamOptions `json:"stream_options,omitempty"`
+	MaxCompletionTokens int            `json:"max_completion_tokens,omitempty"`
+	Temperature         *float64       `json:"temperature,omitempty"`
+	Store               *bool          `json:"store,omitempty"`
+	PromptCacheKey      string         `json:"prompt_cache_key,omitempty"`
+	ExtraBody           map[string]any `json:"-"`
+}
+
+// openCodeStoreFalse is the constant store:false the CLI emits on
+// non-opencode providers (supportsStore path with no explicit option).
+var openCodeStoreFalse = false
+
+// openCodeCacheKey mirrors model-request.ts promptCacheKey(): legacy 64-hex
+// session IDs travel without the ses_ prefix, current 26-char IDs whole.
+func openCodeCacheKey(session string) string {
+	if len(session) == 68 && session[:4] == "ses_" {
+		hex := true
+		for i := 4; i < len(session); i++ {
+			c := session[i]
+			if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+				hex = false
+				break
+			}
+		}
+		if hex {
+			return session[4:]
+		}
+	}
+	return session
+}
+
+func marshalOpenCodeRequest(session string, r chatRequest) ([]byte, error) {
+	wire := openCodeRequest{
+		Model:               r.Model,
+		Messages:            r.Messages,
+		Tools:               r.Tools,
+		ToolChoice:          r.ToolChoice,
+		Stream:              r.Stream,
+		StreamOptions:       r.StreamOptions,
+		MaxCompletionTokens: r.MaxCompletionTokens,
+		Temperature:         r.Temperature,
+		PromptCacheKey:      openCodeCacheKey(session),
+		ExtraBody:           r.ExtraBody,
+	}
+	if !r.OpencodeOmitStore {
+		wire.Store = &openCodeStoreFalse
+	}
+	raw, err := json.Marshal(wire)
+	if err != nil {
+		return nil, err
+	}
+	if len(wire.ExtraBody) == 0 {
+		return raw, nil
+	}
+	var body map[string]any
+	if err := json.Unmarshal(raw, &body); err != nil {
+		return nil, err
+	}
+	maps.Copy(body, cleanExtraBody(wire.ExtraBody))
+	return json.Marshal(body)
+}
+
+// decodedBody couples a Content-Encoding decoder with the underlying response
+// body. Codec Close methods (gzip/flate) do not close — nor unblock a blocked
+// Read on — the transport connection, so ownership of the raw body moves here:
+// closing the decoded body tears down the connection, which is what lets the
+// SSE stall watchdog and context cancellation always unblock scanner.Scan,
+// regardless of codec.
+type decodedBody struct {
+	io.Reader
+	decoder io.Closer // per-codec decoder; may be nil when GC-owned
+	raw     io.ReadCloser
+}
+
+func (d *decodedBody) Close() error {
+	if d.decoder != nil {
+		_ = d.decoder.Close()
+	}
+	return d.raw.Close()
+}
+
+// decompressBody unwraps the response body according to Content-Encoding.
+// Server may compress responses, so the SSE parser must decode manually.
+func decompressBody(resp *http.Response) (io.ReadCloser, error) {
+	raw := resp.Body
+	switch strings.ToLower(strings.TrimSpace(resp.Header.Get("Content-Encoding"))) {
+	case "gzip":
+		zr, err := gzip.NewReader(raw)
+		if err != nil {
+			raw.Close()
+			return nil, err
+		}
+		return &decodedBody{Reader: zr, decoder: zr, raw: raw}, nil
+	case "deflate":
+		fr := flate.NewReader(raw)
+		return &decodedBody{Reader: fr, decoder: fr, raw: raw}, nil
+	case "br":
+		return &decodedBody{Reader: brotli.NewReader(raw), raw: raw}, nil
+	case "zstd":
+		zr, err := zstd.NewReader(raw)
+		if err != nil {
+			raw.Close()
+			return nil, err
+		}
+		rc := zr.IOReadCloser()
+		return &decodedBody{Reader: rc, decoder: rc, raw: raw}, nil
+	default:
+		return raw, nil
+	}
+}
