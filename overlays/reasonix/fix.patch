@@ -0,0 +1,140 @@
+package openai
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"reasonix/internal/contract/provider"
+)
+
+// zenGateway stands in for opencode.ai/zen/v1: it requires the CLI wire
+// shape (identity headers, tool names, stream) and records what it saw.
+type zenSeen struct {
+	headers http.Header
+	body    map[string]any
+}
+
+func zenGateway(t *testing.T, seen *zenSeen) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		seen.headers = r.Header.Clone()
+		_ = json.Unmarshal(raw, &seen.body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
+	}))
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func zenClient(t *testing.T, srv *httptest.Server) *client {
+	t.Helper()
+	p, err := New(provider.Config{Name: "opencode", BaseURL: "https://opencode.ai/zen/v1", Model: "big-pickle", APIKey: "public"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	c := p.(*client)
+	if !c.opencode {
+		t.Fatalf("client for opencode/zen/v1 is not flagged opencode")
+	}
+	c.http = srv.Client()
+	c.requestURLForTest(srv.URL)
+	return c
+}
+
+func (c *client) requestURLForTest(url string) {
+	c.chatURL = url
+}
+
+func TestZenChatCarriesCLIIdentity(t *testing.T) {
+	var seen zenSeen
+	srv := zenGateway(t, &seen)
+	c := zenClient(t, srv)
+	streamOnce(t, c)
+
+	h := seen.headers
+	if got := h.Get("User-Agent"); got != provider.OpenCodeUserAgentOpenAI {
+		t.Fatalf("User-Agent = %q, want %q", got, provider.OpenCodeUserAgentOpenAI)
+	}
+	if got := h.Get("x-opencode-client"); got != "cli" {
+		t.Fatalf("x-opencode-client = %q, want cli", got)
+	}
+	for _, k := range []string{"x-opencode-session", "x-opencode-request", "x-opencode-project"} {
+		if h.Get(k) == "" {
+			t.Fatalf("missing %s header", k)
+		}
+	}
+	if !strings.HasPrefix(h.Get("x-opencode-session"), "ses_") {
+		t.Fatalf("x-opencode-session = %q, want ses_ prefix", h.Get("x-opencode-session"))
+	}
+	if !strings.HasPrefix(h.Get("x-opencode-request"), "msg_") {
+		t.Fatalf("x-opencode-request = %q, want msg_ prefix", h.Get("x-opencode-request"))
+	}
+	if h.Get("Authorization") != "" {
+		t.Fatalf("Authorization = %q, want empty for anonymous zen", h.Get("Authorization"))
+	}
+}
+
+func TestZenChatRenamesReadTool(t *testing.T) {
+	var seen zenSeen
+	srv := zenGateway(t, &seen)
+	c := zenClient(t, srv)
+	ch, err := c.Stream(t.Context(), provider.Request{
+		Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}},
+		Tools: []provider.ToolSchema{
+			{Name: "read_file", Description: "read"},
+			{Name: "bash", Description: "shell"},
+		},
+	})
+	if err != nil {
+		t.Fatalf("Stream: %v", err)
+	}
+	for chunk := range ch {
+		if chunk.Type == provider.ChunkError {
+			t.Fatalf("stream error: %v", chunk.Err)
+		}
+	}
+	var names []string
+	for _, tool := range seen.body["tools"].([]any) {
+		fn := tool.(map[string]any)["function"].(map[string]any)
+		names = append(names, fn["name"].(string))
+	}
+	if len(names) != 2 || names[0] != "read" || names[1] != "bash" {
+		t.Fatalf("wire tool names = %v, want [read bash]", names)
+	}
+}
+
+func TestApplyOpencodeNames(t *testing.T) {
+	req := provider.Request{Tools: []provider.ToolSchema{{Name: "read_file"}, {Name: "bash"}}}
+	got := ApplyOpencodeNames("opencode", "https://opencode.ai/zen/v1", req)
+	if got.Tools[0].Name != "read" || got.Tools[1].Name != "bash" {
+		t.Fatalf("renamed = %v", got.Tools)
+	}
+	// Non-opencode providers pass through untouched.
+	plain := ApplyOpencodeNames("deepseek", "https://api.deepseek.com", req)
+	if plain.Tools[0].Name != "read_file" {
+		t.Fatalf("non-opencode renamed = %v", plain.Tools)
+	}
+	// Path-based match (capture proxy rewriting base_url to an IP).
+	byPath := ApplyOpencodeNames("relay", "http://127.0.0.1:8080/zen/v1", req)
+	if byPath.Tools[0].Name != "read" {
+		t.Fatalf("path-matched provider not renamed = %v", byPath.Tools)
+	}
+}
+
+func TestIsZenHost(t *testing.T) {
+	for _, url := range []string{"https://opencode.ai/zen/v1", "http://127.0.0.1:8080/zen/v1", "https://gateway.zenmux.ai/v1"} {
+		if !isZenHost(url) {
+			t.Errorf("isZenHost(%q) = false, want true", url)
+		}
+	}
+	for _, url := range []string{"https://api.deepseek.com", "https://opencode.ai/zen/go/v1", "https://example.com/v1"} {
+		if isZenHost(url) {
+			t.Errorf("isZenHost(%q) = true, want false", url)
+		}
+	}
+}
