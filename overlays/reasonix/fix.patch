+// minUsableSummaryWindow stops the halving loop: below this the session
+// cannot hold even a system message plus a digest, and compaction is paused
+// by the too-small-window path instead.
+const minUsableSummaryWindow = 32768
+
+// summaryCapacityHints match backend failures that mean "this request was
+// larger than the real model limit". Zen gateway bodies carry no token counts
+// ("Error from provider (Console): Upstream request failed: [1261] Prompt
+// exceeds max length"), stream cuts ("unexpected EOF") and empty completions
+// are the same failure in disguise, and none of them parse as a trusted
+// ContextLimitError — so the fold loop recalibrates off these hints.
+var summaryCapacityHints = []string{
+	"prompt exceeds",
+	"exceeds max length",
+	"maximum context",
+	"context length",
+	"too long",
+	"unexpected eof",
+	"returned empty output",
+}
+
+func isSummaryCapacityError(err error) bool {
+	if err == nil {
+		return false
+	}
+	msg := strings.ToLower(err.Error())
+	for _, hint := range summaryCapacityHints {
+		if strings.Contains(msg, hint) {
+			return true
+		}
+	}
+	return false
+}
+
+// shrinkWindowOnSummaryCapacityError halves the effective window when a
+// summary request failed in a way that indicates the real backend limit sits
+// below the configured one. learnContextBudget only shrinks, never widens,
+// and every consumer (hard ceiling, fold trigger, summary prefix fitter)
+// reads it through effectiveContextWindow, so one learned value recalibrates
+// the whole fold loop. Returns true when the window shrank and the caller
+// should retry.
+func (a *Agent) shrinkWindowOnSummaryCapacityError(err error) bool {
+	if !isSummaryCapacityError(err) {
+		return false
+	}
+	half := a.effectiveContextWindow() / 2
+	if half < minUsableSummaryWindow {
+		return false
+	}
+	a.learnContextBudget(half, 0, false)
+	return true
+}
+
+// windowLearnedBelowConfig reports whether a learned window exists and sits
+// below the configured one. learnContextBudget only shrinks, so this is proof
+// the real backend limit is smaller than configured (capacity-error shrink or
+// a gateway-reported overflow), not just an estimate.
+func (a *Agent) windowLearnedBelowConfig() bool {
+	if a == nil || a.contextWindow <= 0 {
+		return false
+	}
+	snap := a.sess.output.learned.Load()
+	return snap != nil && snap.windowTokens > 0 && snap.windowTokens < a.contextWindow
+}
