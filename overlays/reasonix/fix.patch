@@ -0,0 +1,72 @@
+package openai
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"io"
+	"net/http"
+	"testing"
+
+	"github.com/andybalholm/brotli"
+	"github.com/klauspost/compress/zstd"
+)
+
+func TestDecompressBodyAllCodecs(t *testing.T) {
+	orig := "stream data: hello world\n" + `{"id":"x","object":"chat.completion.chunk"}`
+
+	cases := []struct {
+		name   string
+		enc    string
+		encode func() []byte
+	}{
+		{"identity", "", func() []byte { return []byte(orig) }},
+		{"gzip", "gzip", func() []byte {
+			var b bytes.Buffer
+			w := gzip.NewWriter(&b)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+		{"br", "br", func() []byte {
+			var b bytes.Buffer
+			w := brotli.NewWriter(&b)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+		{"zstd", "zstd", func() []byte {
+			var b bytes.Buffer
+			w, _ := zstd.NewWriter(&b)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+		{"raw-deflate", "deflate", func() []byte {
+			var b bytes.Buffer
+			w, _ := flate.NewWriter(&b, flate.DefaultCompression)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			resp := &http.Response{Header: http.Header{}}
+			resp.Header.Set("Content-Encoding", tc.enc)
+			resp.Body = io.NopCloser(bytes.NewReader(tc.encode()))
+			rd, err := decompressBody(resp)
+			if err != nil {
+				t.Fatalf("decompressBody: %v", err)
+			}
+			got, err := io.ReadAll(rd)
+			rd.Close()
+			if err != nil {
+				t.Fatalf("read: %v", err)
+			}
+			if string(got) != orig {
+				t.Fatalf("mismatch:\n got  %q\n want %q", got, orig)
+			}
+		})
+	}
+}
diff --git a/internal/provider/openai/opencode_id.go b/internal/provider/openai/opencode_id.go
new file mode 100644
index 000000000..6bf43bce8
--- /dev/null
+++ b/internal/provider/openai/opencode_id.go
@@ -0,0 +1,80 @@
+package openai
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"sync"
+	"time"
+)
+
+// Port of opencode's ID generator (packages/schema/src/identifier.ts):
+// 12 lowercase-hex chars of the 48-bit time+counter value (big-endian,
+// bitwise-NOT when descending) plus 14 chars of random base62 drawn as
+// random-byte % 62 over "0-9A-Za-z". Session IDs use the descending
+// encoding via SessionID.create; the counter resets every millisecond.
+//
+//   - session IDs use the descending encoding (time+counter bitwise-NOT) so they
+//     sort newest-first;
+//   - message IDs use the ascending encoding (bare time+counter).
+//
+// The 48-bit time component wraps every 2^36 ms (~2.2 years); decoding it for
+// assertions must account for that, exactly like opencode's own timestamp().
+const (
+	opencodeIDLength    = 26
+	opencodeIDTimeBytes = 6
+)
+
+const opencodeIDChars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+var (
+	opencodeIDMu      sync.Mutex
+	opencodeIDLastMS  int64
+	opencodeIDCounter uint64
+)
+
+// opencodeCreate mirrors id.ts create(): a monotonic per-millisecond counter is
+// folded into a 48-bit time+counter value, optionally descending (bitwise-NOT),
+// hex-encoded to 6 bytes, and padded with random base62 to a 26-char total.
+func opencodeCreate(prefix string, descending bool) string {
+	ms := time.Now().UnixMilli()
+
+	opencodeIDMu.Lock()
+	if ms != opencodeIDLastMS {
+		opencodeIDLastMS = ms
+		opencodeIDCounter = 0
+	}
+	opencodeIDCounter++
+	counter := opencodeIDCounter
+	opencodeIDMu.Unlock()
+
+	v := uint64(ms)*0x1000 + counter
+	if descending {
+		v = ^v
+	}
+	v &= 0xFFFF_FFFF_FFFF
+
+	timeBytes := [opencodeIDTimeBytes]byte{
+		byte(v >> 40),
+		byte(v >> 32),
+		byte(v >> 24),
+		byte(v >> 16),
+		byte(v >> 8),
+		byte(v),
+	}
+	hexPart := make([]byte, 12)
+	hex.Encode(hexPart, timeBytes[:])
+
+	return prefix + "_" + string(hexPart) + opencodeRandomBase62(opencodeIDLength-12)
+}
+
+func opencodeRandomBase62(n int) string {
+	buf := make([]byte, n)
+	if _, err := rand.Read(buf); err != nil {
+		panic("opencode: crypto/rand failed: " + err.Error())
+	}
+	out := make([]byte, n)
+	for i, b := range buf {
+		out[i] = opencodeIDChars[b%62]
+	}
+	return string(out)
+}
diff --git a/internal/provider/openai/opencode_id_test.go b/internal/provider/openai/opencode_id_test.go
new file mode 100644
index 000000000..d7ac21dd0
--- /dev/null
+++ b/internal/provider/openai/opencode_id_test.go
@@ -0,0 +1,38 @@
+package openai
+
+import (
+	"regexp"
+	"testing"
+)
+
+func TestOpencodeIDFormat(t *testing.T) {
+	sesRe := regexp.MustCompile(`^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$`)
+	msgRe := regexp.MustCompile(`^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$`)
+	for i := 0; i < 200; i++ {
+		ses := opencodeCreate("ses", true)
+		msg := opencodeCreate("msg", false)
+		if !sesRe.MatchString(ses) {
+			t.Fatalf("bad session id %q", ses)
+		}
+		if !msgRe.MatchString(msg) {
+			t.Fatalf("bad message id %q", msg)
+		}
+	}
+}
+
+func TestOpencodeIDsMonotonic(t *testing.T) {
+	var lastSes string
+	for i := 0; i < 100; i++ {
+		ses := opencodeCreate("ses", true)
+		msg := opencodeCreate("msg", false)
+		if lastSes == "" {
+			lastSes = ses
+			continue
+		}
+		if ses == lastSes {
+			t.Fatalf("duplicate session id %q", ses)
+		}
+		lastSes = ses
+		_ = msg
+	}
+}
diff --git a/internal/provider/openai/opencode_stall_test.go b/internal/provider/openai/opencode_stall_test.go
new file mode 100644
index 000000000..908b7c3f0
--- /dev/null
+++ b/internal/provider/openai/opencode_stall_test.go
@@ -0,0 +1,78 @@
+package openai
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	"reasonix/internal/provider"
+)
+
+// stalledConnBody models a half-open transport body after Content-Encoding
+// framing: some buffered bytes are served, then every Read blocks forever
+// until Close tears the connection down — exactly how net.Conn behaves when a
+// server stalls mid-stream.
+type stalledConnBody struct {
+	data   []byte
+	off    int
+	closed chan struct{}
+	once   sync.Once
+}
+
+func newStalledConnBody(data []byte) *stalledConnBody {
+	return &stalledConnBody{data: data, closed: make(chan struct{})}
+}
+
+func (s *stalledConnBody) Read(p []byte) (int, error) {
+	if s.off < len(s.data) {
+		n := copy(p, s.data[s.off:])
+		s.off += n
+		return n, nil
+	}
+	<-s.closed
+	return 0, errors.New("stalled connection closed by watchdog")
+}
+
+func (s *stalledConnBody) Close() error {
+	s.once.Do(func() { close(s.closed) })
+	return nil
+}
+
+// TestReadStreamStallRecoversThroughDecompression verifies the SSE stall
+// watchdog still unblocks scanner.Scan when the response body is wrapped by a
+// Content-Encoding decoder. A half-open compressed stream must surface at
+// idleTimeout instead of hanging forever: closing the decoder alone does not
+// unblock the underlying read, so decoder wrappers must forward ownership of
+// the raw body.
+func TestReadStreamStallRecoversThroughDecompression(t *testing.T) {
+	var buf bytes.Buffer
+	gw := gzip.NewWriter(&buf)
+	gw.Write([]byte("data: {\"choices\":[{\"delta\":{\"content\":\"hi\"}}]}\n\n"))
+	gw.Close()
+
+	raw := newStalledConnBody(buf.Bytes())
+	resp := &http.Response{
+		Header: http.Header{"Content-Encoding": []string{"gzip"}},
+		Body:   raw,
+	}
+	c := &client{name: "x", idleTimeout: 100 * time.Millisecond}
+	ch := make(chan provider.Chunk, 8)
+	done := make(chan error, 1)
+	go func() {
+		_, err := c.readStream(context.Background(), resp, ch)
+		close(ch)
+		done <- err
+	}()
+
+	select {
+	case <-done:
+		// Watchdog unblocked the scanner through the decoder chain.
+	case <-time.After(3 * time.Second):
+		t.Fatal("readStream hung: stall watchdog could not unblock the decompressed body")
+	}
+}
diff --git a/internal/provider/openai/opencode_stream_test.go b/internal/provider/openai/opencode_stream_test.go
new file mode 100644
index 000000000..a6c7f4a66
--- /dev/null
+++ b/internal/provider/openai/opencode_stream_test.go
@@ -0,0 +1,222 @@
+package openai
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// TestOpencodeStreamLocal exercises the full opencode wire path against a local
+// mock: request headers/body shape stamped by applyOpenCodeHeaders +
+// marshalOpenCodeRequest, and readStream parsing of an SSE stream using CRLF
+// line endings and multi-byte UTF-8 across a tool-call argument boundary.
+func TestOpencodeStreamLocal(t *testing.T) {
+	var gotReq *http.Request
+	var gotBody []byte
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotReq = r
+		gotBody, _ = io.ReadAll(r.Body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		// CRLF delimited, UTF-8 multi-byte split across tool-call arg deltas
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}\r\n\r\n")
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"echo 中文\\\"\"}}]}}]}\r\n\r\n")
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"}\"}}]}}]}\r\n\r\n")
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"content\":\"完成\"}}]}\r\n\r\n")
+		io.WriteString(w, "data: [DONE]\r\n\r\n")
+	}))
+	defer srv.Close()
+
+	p, err := New(provider.Config{Name: "opencode-zen", BaseURL: srv.URL, Model: "mimo-v2.5-free", APIKey: "public"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	ch, err := p.Stream(context.Background(), provider.Request{
+		Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}},
+	})
+	if err != nil {
+		t.Fatalf("Stream: %v", err)
+	}
+	var text strings.Builder
+	var tool *provider.ToolCall
+	for c := range ch {
+		switch c.Type {
+		case provider.ChunkError:
+			t.Fatalf("stream error: %v", c.Err)
+		case provider.ChunkText:
+			text.WriteString(c.Text)
+		case provider.ChunkToolCallStart, provider.ChunkToolCallArgsDelta:
+			if tool == nil || c.ToolCall.Name != "" {
+				tool = c.ToolCall
+			}
+		case provider.ChunkToolCall:
+			tool = c.ToolCall
+		}
+	}
+
+	// Request wire shape
+	if gotReq == nil {
+		t.Fatal("server saw no request")
+	}
+	if got := gotReq.Header.Get("User-Agent"); got != opencodeUserAgent {
+		t.Errorf("User-Agent = %q", got)
+	}
+	for _, k := range []string{"x-opencode-client", "x-opencode-project", "x-opencode-session", "x-session-affinity", "x-session-id"} {
+		if got := gotReq.Header.Get(k); got == "" {
+			t.Errorf("missing header %s", k)
+		}
+	}
+	if got := gotReq.Header.Get("x-opencode-request"); got != "" {
+		t.Errorf("x-opencode-request = %q, want absent (v2 CLI dropped it)", got)
+	}
+	var wire struct {
+		Keys []string
+	}
+	var top map[string]any
+	if err := json.Unmarshal(gotBody, &top); err != nil {
+		t.Fatalf("body: %v", err)
+	}
+	var order []string
+	for k := range top {
+		order = append(order, k)
+	}
+	_ = wire
+	if len(top) == 0 {
+		t.Error("empty body")
+	}
+	fmt.Printf("  body keys: %v\n", order)
+
+	// Stream output
+	if text.String() != "完成" {
+		t.Errorf("text = %q, want 完成", text.String())
+	}
+	if tool == nil || tool.Name != "bash" || tool.Arguments != `{"command":"echo 中文"}` {
+		t.Errorf("tool = %+v, want bash with UTF-8 args", tool)
+	} else {
+		fmt.Printf("  tool parsed OK: %s %s\n", tool.Name, tool.Arguments)
+	}
+}
+
+// TestOpencodeBodyKeyOrder pins the exact wire key order against the v2 CLI
+// source (openai-chat.ts fromRequest): model, messages, tools, tool_choice,
+// stream, stream_options, max_completion_tokens, temperature, store,
+// prompt_cache_key. Unset keys are dropped like the CLI's JSON.stringify
+// dropping undefined. In particular the output budget travels as
+// max_completion_tokens (zen is not in the legacy max_tokens list) and never
+// as max_tokens.
+func TestOpencodeBodyKeyOrder(t *testing.T) {
+	temp := 0.7
+	raw, err := marshalOpenCodeRequest("ses_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", chatRequest{
+		Model:               "qwen/qwen3-max",
+		Messages:            []chatMessage{{Role: "user", Content: "hi"}},
+		Tools:               []chatTool{{Type: "function", Function: chatFunction{Name: "bash"}}},
+		ToolChoice:          "auto",
+		Stream:              true,
+		StreamOptions:       &streamOptions{IncludeUsage: true},
+		MaxCompletionTokens: 32000,
+		Temperature:         &temp,
+	})
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	body := string(raw)
+	wantOrder := []string{"model", "messages", "tools", "tool_choice", "stream", "stream_options",
+		"max_completion_tokens", "temperature", "store", "prompt_cache_key"}
+	last := -1
+	for _, k := range wantOrder {
+		idx := strings.Index(body, `"`+k+`"`)
+		if idx < 0 {
+			t.Fatalf("body missing key %q: %s", k, body)
+		}
+		if idx < last {
+			t.Fatalf("key %q out of order: %s", k, body)
+		}
+		last = idx
+	}
+	for _, absent := range []string{`"max_tokens"`, `"reasoning_effort"`, `"thinking"`, `"top_p"`} {
+		if strings.Contains(body, absent+":") {
+			t.Fatalf("body must not contain %s: %s", absent, body)
+		}
+	}
+
+	// Omit path (the opencode provider itself): store dropped like the CLI.
+	raw, err = marshalOpenCodeRequest("ses_005e126cdffeuWNYZDAFCJK61s", chatRequest{
+		Model:             "qwen/qwen3-max",
+		Messages:          []chatMessage{{Role: "user", Content: "hi"}},
+		Stream:            true,
+		StreamOptions:     &streamOptions{IncludeUsage: true},
+		OpencodeOmitStore: true,
+	})
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	var top map[string]any
+	if err := json.Unmarshal(raw, &top); err != nil {
+		t.Fatalf("body: %v", err)
+	}
+	for k := range map[string]bool{"model": true, "messages": true, "stream": true, "stream_options": true, "prompt_cache_key": true} {
+		if _, ok := top[k]; !ok {
+			t.Errorf("default body missing key %q: %s", k, raw)
+		}
+	}
+	for k := range top {
+		switch k {
+		case "model", "messages", "stream", "stream_options", "prompt_cache_key":
+		default:
+			t.Errorf("default body has unexpected key %q: %s", k, raw)
+		}
+	}
+	if top["prompt_cache_key"] != "ses_005e126cdffeuWNYZDAFCJK61s" {
+		t.Errorf("prompt_cache_key = %v, want whole session ID", top["prompt_cache_key"])
+	}
+}
+
+// TestOpenCodeOmitsStore mirrors detectSupportsStore(): only the opencode
+// provider itself (by name, or any name on an opencode.ai host) omits store;
+// custom names on other hosts (zenmux, capture proxies) send store:false.
+func TestOpenCodeOmitsStore(t *testing.T) {
+	cases := []struct {
+		name, baseURL string
+		want          bool
+	}{
+		{"opencode", "https://opencode.ai/zen/v1", true},
+		{"Opencode", "https://zenmux.ai/api/v1", true},
+		{"custom-name", "https://opencode.ai/zen/v1/chat/completions", true},
+		{"custom-name", "https://zenmux.ai/api/v1/chat/completions", false},
+		{"custom-name", "http://127.0.0.1:8080/zen/v1/chat/completions", false},
+		{"opencode-go", "https://opencode.ai/zen/go/v1", true},
+		{"other", "https://api.deepseek.com", false},
+		{"", "::not-a-url::", false},
+	}
+	for _, tc := range cases {
+		if got := openCodeOmitsStore(tc.name, tc.baseURL); got != tc.want {
+			t.Errorf("openCodeOmitsStore(%q, %q) = %v, want %v", tc.name, tc.baseURL, got, tc.want)
+		}
+	}
+}
+
+// TestOpenCodeCacheKey mirrors model-request.ts promptCacheKey(): only legacy
+// 64-hex session IDs shed the ses_ prefix.
+func TestOpenCodeCacheKey(t *testing.T) {
+	legacy := "ses_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+	if got := openCodeCacheKey(legacy); got != legacy[4:] {
+		t.Errorf("legacy cache key = %q, want prefix stripped", got)
+	}
+	for _, whole := range []string{
+		"ses_005e126cdffeuWNYZDAFCJK61s",
+		"ses_0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef",
+		"other",
+		"",
+	} {
+		if got := openCodeCacheKey(whole); got != whole {
+			t.Errorf("openCodeCacheKey(%q) = %q, want unchanged", whole, got)
+		}
+	}
+}
