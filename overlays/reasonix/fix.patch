+	}
+	c := p.(*client)
+	if got := c.ContextBudgetPolicy(); got.WindowMode == provider.ContextWindowShared {
+		t.Fatalf("opencode-zen mimo policy = %+v, want independent", got)
+	}
+	if c.SharesContextWindow() {
+		t.Fatal("opencode-zen mimo must not share the context window")
