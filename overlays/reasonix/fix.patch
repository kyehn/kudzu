+package provider
+
+import (
+	"regexp"
+	"testing"
+)
+
+func TestOpenCodeIDFormat(t *testing.T) {
+	sesRe := regexp.MustCompile(`^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$`)
+	msgRe := regexp.MustCompile(`^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$`)
+	for i := 0; i < 200; i++ {
+		ses := OpenCodeCreate("ses", true)
+		msg := OpenCodeCreate("msg", false)
+		if !sesRe.MatchString(ses) {
+			t.Fatalf("bad session id %q", ses)
+		}
+		if !msgRe.MatchString(msg) {
+			t.Fatalf("bad message id %q", msg)
+		}
+	}
+}
+
+func TestOpenCodeIDsMonotonic(t *testing.T) {
+	var lastSes string
+	for i := 0; i < 100; i++ {
+		ses := OpenCodeCreate("ses", true)
+		msg := OpenCodeCreate("msg", false)
+		if lastSes == "" {
+			lastSes = ses
+			continue
+		}
+		if ses == lastSes {
+			t.Fatalf("duplicate session id %q", ses)
+		}
+		lastSes = ses
+		_ = msg
+	}
+}
+
+func TestIsOpenCodeScope(t *testing.T) {
+	cases := []struct {
+		name, baseURL string
+		want          bool
+	}{
+		{"opencode", "https://opencode.ai/zen/v1", true},
+		{"opencode-zen", "https://opencode.ai/zen/v1", true},
+		{"opencode-responses", "https://opencode.ai/zen/v1", true},
+		{"custom-name", "https://opencode.ai/zen/v1/chat/completions", true},
+		{"custom-name", "http://127.0.0.1:8080/zen/v1/chat/completions", true},
+		{"custom-name", "https://zenmux.ai/api/v1/chat/completions", true},
+		{"custom-name", "https://console.zenmux.ai/api/v1", true},
+		{"opencode-go", "https://opencode.ai/zen/go/v1", false},
+		{"opencode-go", "http://127.0.0.1:8080", false},
+		{"opencode-go-deepseek", "https://opencode.ai/zen/go/v1", false},
+		{"opencode-go-responses", "https://opencode.ai/zen/go/v1", false},
+		{"opencode-zen-anthropic", "https://opencode.ai/zen", false},
+		{"other", "https://api.deepseek.com", false},
+	}
+	for _, tc := range cases {
+		if got := IsOpenCode(tc.name, tc.baseURL); got != tc.want {
+			t.Errorf("IsOpenCode(%q, %q) = %v, want %v", tc.name, tc.baseURL, got, tc.want)
+		}
+	}
+}
+
+func TestApplyOpenCodeCLIHeaders(t *testing.T) {
+	header := map[string][]string{
+		"User-Agent":         {"Reasonix"},
+		"X-Opencode-Client":  {"custom"},
+		"X-Opencode-Session": {"old"},
+	}
+	ApplyOpenCodeCLIHeaders(header, "ses_example", "global")
+	if got := header["User-Agent"][0]; got != OpenCodeUserAgent {
+		t.Fatalf("User-Agent = %q", got)
+	}
+	for key, want := range map[string]string{
+		"x-opencode-client":  "cli",
+		"x-opencode-project": "global",
+		"x-opencode-session": "ses_example",
+	} {
+		values, ok := header[key]
+		if !ok || len(values) != 1 || values[0] != want {
+			t.Fatalf("header %s = %q, want %q", key, values, want)
+		}
+	}
+	// v1 sends a fresh ascending msg_ request ID per request and no
+	// x-session-affinity/X-Session-Id on the opencode provider path.
+	values, ok := header["x-opencode-request"]
+	if !ok || len(values) != 1 || len(values[0]) != 30 || values[0][:4] != "msg_" {
+		t.Fatalf("header x-opencode-request = %q, want fresh msg_ ID", values)
+	}
+	for _, key := range []string{"x-session-affinity", "x-session-id", "X-Session-Affinity", "X-Session-Id"} {
+		if values, ok := header[key]; ok {
+			t.Fatalf("header %s = %q, want absent on opencode path (v1.18.31)", key, values)
+		}
+	}
+}
+
+func TestOpenCodeProjectIDResolution(t *testing.T) {
+	// normalizeRemote mirrors packages/core/src/project.ts parts().
+	if got := openCodeNormalizeRemote("https://github.com/kyehn/kudzu.git"); got != "github.com/kyehn/kudzu" {
+		t.Fatalf("normalize https .git = %q", got)
+	}
+	if got := openCodeNormalizeRemote("git@github.com:kyehn/kudzu.git"); got != "github.com/kyehn/kudzu" {
+		t.Fatalf("normalize scp = %q", got)
+	}
+	if openCodeNormalizeRemote("file:///tmp/repo") != "" {
+		t.Fatal("file: URLs must not qualify")
+	}
+}
diff --git a/internal/provider/responses/encrypted_retry_test.go b/internal/provider/responses/encrypted_retry_test.go
new file mode 100644
index 0000000..d674d19
--- /dev/null
+++ b/internal/provider/responses/encrypted_retry_test.go
@@ -0,0 +1,118 @@
+package responses
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// The opencode Console gateway may serve consecutive turns with different
+// callers (reroute, rotated key): a replayed encrypted_content issued to the
+// previous caller then 400s with "was not issued to this caller". The client
+// must retry once with the plaintext summary only, instead of failing the
+// turn — no response has streamed yet, so the retry is side-effect free.
+
+func TestForeignEncryptedReasoningErrorMatches(t *testing.T) {
+	match := &provider.APIError{Status: http.StatusBadRequest,
+		Body: `{"model":"muse-spark-1.5","error":{"type":"invalid_request_error","message":"Error from provider (Console): Upstream request failed: [invalid_request_error] reasoning ` + "`encrypted_content`" + ` was not issued to this caller"}}`}
+	if !isForeignEncryptedReasoningError(match) {
+		t.Fatalf("observed Console rejection not recognized: %q", match.Body)
+	}
+	for _, err := range []error{
+		nil,
+		&provider.APIError{Status: http.StatusBadRequest, Body: `{"type":"invalid_request_error","message":"previous_response_id not found or has expired"}`},
+		&provider.APIError{Status: http.StatusTooManyRequests, Body: "encrypted_content was not issued to this caller"},
+		&provider.APIError{Status: http.StatusBadRequest, Body: `{"type":"invalid_request_error","message":"max_output_tokens reached"}`},
+	} {
+		if isForeignEncryptedReasoningError(err) {
+			t.Fatalf("non-matching error recognized: %#v", err)
+		}
+	}
+}
+
+func TestBodyWithoutEncryptedReasoningStripsBlob(t *testing.T) {
+	body := map[string]any{
+		"model": "muse-spark",
+		"input": []map[string]any{
+			{"role": "user", "content": "hi"},
+			{"id": "rs_1", "type": "reasoning", "status": "completed",
+				"summary":           []map[string]string{{"type": "summary_text", "text": "thought"}},
+				"encrypted_content": "opaque-prior"},
+		},
+	}
+	stripped := bodyWithoutEncryptedReasoning(body)
+	if stripped == nil {
+		t.Fatal("body carrying encrypted_content returned nil")
+	}
+	raw, _ := json.Marshal(stripped["input"])
+	if strings.Contains(string(raw), "opaque-prior") {
+		t.Fatalf("encrypted_content survived the strip: %s", raw)
+	}
+	if !strings.Contains(string(raw), "thought") {
+		t.Fatalf("plaintext summary lost in the strip: %s", raw)
+	}
+	// The source body is untouched: the first attempt's shape is preserved.
+	orig, _ := json.Marshal(body["input"])
+	if !strings.Contains(string(orig), "opaque-prior") {
+		t.Fatalf("source body mutated by the strip: %s", orig)
+	}
+	if bodyWithoutEncryptedReasoning(map[string]any{"input": "last message only"}) != nil {
+		t.Fatal("stateful string input must not strip")
+	}
+	if bodyWithoutEncryptedReasoning(map[string]any{"input": []map[string]any{{"role": "user", "content": "hi"}}}) != nil {
+		t.Fatal("input without encrypted_content must return nil (no retry)")
+	}
+}
+
+func TestStreamRetriesWithoutEncryptedReasoning(t *testing.T) {
+	const prior = `{"id":"rs_prior","type":"reasoning","status":"completed","summary":[{"type":"summary_text","text":"prior thought"}],"encrypted_content":"opaque-prior"}`
+	var calls atomic.Int32
+	var secondBody []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		payload, _ := io.ReadAll(r.Body)
+		if calls.Add(1) == 1 {
+			if !strings.Contains(string(payload), "opaque-prior") {
+				t.Errorf("first attempt should replay the stored blob, got: %s", payload)
+			}
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(`{"error":{"type":"invalid_request_error","message":"Upstream request failed: [invalid_request_error] reasoning ` + "`encrypted_content`" + ` was not issued to this caller"}}`))
+			return
+		}
+		secondBody = payload
+		writeEvents(w,
+			`{"type":"response.output_text.delta","output_index":0,"content_index":0,"delta":"recovered"}`,
+			`{"type":"response.completed","response":{"id":"resp_2","status":"completed","output":[{"type":"message","id":"m_1","status":"completed","role":"assistant","content":[{"type":"output_text","text":"recovered"}]}],"usage":{"input_tokens":4,"output_tokens":2,"total_tokens":6}}}`,
+		)
+	}))
+	defer server.Close()
+
+	client := New(Config{Name: "opencode-responses", APIKey: "key", BaseURL: server.URL, Model: "muse-spark-test", Mode: "stateless"})
+	chunks := collect(t, client, provider.Request{Messages: []provider.Message{
+		{Role: provider.RoleUser, Content: "first"},
+		{Role: provider.RoleAssistant, Content: "answer", ResponsesItems: []json.RawMessage{json.RawMessage(prior)}},
+		{Role: provider.RoleUser, Content: "second"},
+	}})
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("requests = %d, want exactly one retry", got)
+	}
+	if strings.Contains(string(secondBody), "opaque-prior") || strings.Contains(string(secondBody), "encrypted_content") {
+		t.Fatalf("retry still carried the foreign blob: %s", secondBody)
+	}
+	if !strings.Contains(string(secondBody), "prior thought") {
+		t.Fatalf("retry lost the plaintext summary: %s", secondBody)
+	}
+	var text strings.Builder
+	for _, chunk := range chunks {
+		text.WriteString(chunk.Text)
+	}
+	if !strings.Contains(text.String(), "recovered") {
+		t.Fatalf("retried turn did not complete: %+v", chunks)
+	}
+}
