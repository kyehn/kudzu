+			"one-word-different Chinese prompts",
+			askQuestionsForMatch("方案", "选择哪个方案部署？", "A", "B"),
+			askQuestionsForMatch("方案", "选择哪个方案回滚？", "A", "B"),
+			false,
+		},
+		{
+			"different options never match",
+			askQuestionsForMatch("依赖库", "这个功能用哪个 HTTP 库实现？", "resty", "net/http"),
+			askQuestionsForMatch("依赖库", "重试逻辑用哪个库实现？", "resty", "backoff"),
+			false,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := sameDecisionAmbiguity(
