+			provider.Message{Role: provider.RoleAssistant, Content: "回答 " + strings.Repeat("y", 1600)},
+		)
+	}
+	// Large but individually foldable active paste: ~135k tokens, so history
+	// + active together cross the 191552 shared ceiling.
+	msgs = append(msgs, provider.Message{Role: provider.RoleUser, Content: "大粘贴 " + strings.Repeat("z", 540_000), CreatedAt: 222})
+	sess := &Session{Messages: append([]provider.Message(nil), msgs...)}
+	a := New(prov, tool.NewRegistry(), sess, Options{
+		ContextWindow: 200_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+	a.activeTurnCreatedAt.Store(222)
+	src := a.estimatedVisibleRequestTokens(a.modelVisibleMessages())
+	hard := a.hardInputCeiling()
+	if src < hard {
+		t.Fatalf("probe setup: source %d below shared ceiling %d", src, hard)
+	}
+	outcome, err := a.compactToProjectionLocked(context.Background(), CompactionTriggerOverflow, "", true, true)
+	if err != nil {
+		t.Fatalf("must-free fold with oversized active turn failed: %v", err)
+	}
+	if outcome == CompactionNoop {
+		t.Fatal("must-free fold returned noop; active turn must be foldable")
+	}
+	after := a.estimatedVisibleRequestTokens(a.modelVisibleMessages())
+	if after >= hard {
+		t.Fatalf("fold did not recover below hard ceiling: %d >= %d", after, hard)
+	}
