diff --git a/internal/provider/openai/host.go b/internal/provider/openai/host.go
index edfa2d656..3ff661074 100644
--- a/internal/provider/openai/host.go
+++ b/internal/provider/openai/host.go
@@ -65,6 +65,32 @@ func IsOpenAI(baseURL string) bool {
 	return strings.EqualFold(u.Hostname(), "api.openai.com")
 }
 
+// IsOpenCode reports whether a provider speaks the opencode CLI wire shape
+// (CLI TLS fingerprint, x-opencode-* headers, fixed body key order, no
+// reasoning fields). It matches the generated config's models.dev names
+// ("opencode", plus "opencode-zen"/"opencode-responses" kept for older
+// configs), the v2 zenmux.ai gateway host, and the v1 Zen path (/zen/v1,
+// which also survives a local capture proxy that rewrites base_url to an
+// IP). The OpenCode Go relay (names "opencode-go*", paths /zen/go*) is
+// deliberately excluded: it is a plain OpenAI-compatible endpoint with
+// per-model reasoning contracts (e.g. kimi-k3 reasoning_effort) that the
+// CLI wire shape would strip.
+func IsOpenCode(name, baseURL string) bool {
+	switch strings.ToLower(strings.TrimSpace(name)) {
+	case "opencode", "opencode-zen", "opencode-responses":
+		return true
+	}
+	u, err := url.Parse(baseURL)
+	if err != nil {
+		return false
+	}
+	host := strings.ToLower(u.Hostname())
+	if host == "zenmux.ai" || strings.HasSuffix(host, ".zenmux.ai") {
