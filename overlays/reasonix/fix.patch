+
+// The physical input ceiling on a shared prompt+completion window must reserve
+// the reply budget; an independent window keeps the old one-token margin.
+func TestHardInputCeilingSharedWindow(t *testing.T) {
+	shared := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	a := New(shared, tool.NewRegistry(), &Session{Messages: []provider.Message{{Role: provider.RoleUser, Content: "x"}}}, Options{
+		ContextWindow: 200_000,
+	}, event.Discard)
+	const want = 200_000 - outputBudgetReserve - protocolReserveTokens
+	if got := a.hardInputCeiling(); got != want {
+		t.Fatalf("shared ceiling = %d, want %d", got, want)
+	}
+
+	indep := &recordingProvider{reply: "x"}
+	b := New(indep, tool.NewRegistry(), &Session{Messages: []provider.Message{{Role: provider.RoleUser, Content: "x"}}}, Options{
+		ContextWindow: 200_000,
+	}, event.Discard)
+	if got, want := b.hardInputCeiling(), 200_000-protocolReserveTokens; got != want {
+		t.Fatalf("independent ceiling = %d, want %d", got, want)
+	}
+}
+
+// A shared-window session that has grown past the physical input ceiling must
+// compact below it (with room for an answer) instead of wedging at the limit.
+func TestSharedWindowOverflowCompactsBelowCeiling(t *testing.T) {
+	prov := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "sys"})
+	for i := 0; i < 460; i++ {
+		msgs = append(msgs, provider.Message{Role: provider.RoleUser, Content: strings.Repeat("turntext ", 60) + "u"})
+		msgs = append(msgs, provider.Message{Role: provider.RoleAssistant, Content: strings.Repeat("worktext ", 140)})
+	}
+	sess := &Session{Messages: append([]provider.Message(nil), msgs...)}
+	a := New(prov, tool.NewRegistry(), sess, Options{
+		ContextWindow: 200_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+
+	src := a.estimatedVisibleRequestTokens(msgs)
+	hard := a.hardInputCeiling()
+	if src < hard {
+		t.Fatalf("probe setup: source %d did not exceed shared ceiling %d", src, hard)
+	}
+	if _, err := a.compactToProjectionLocked(context.Background(), CompactionTriggerOverflow, "", true, true); err != nil {
+		t.Fatalf("overflow compaction failed at source %d: %v", src, err)
+	}
