+	for _, tc := range cases {
+		if got := IsOpenCode(tc.name, tc.baseURL); got != tc.want {
+			t.Errorf("IsOpenCode(%q, %q) = %v, want %v", tc.name, tc.baseURL, got, tc.want)
+		}
+	}
+}
