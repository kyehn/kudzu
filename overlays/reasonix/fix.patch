diff --git a/internal/agent/active_oversize_fold_test.go b/internal/agent/active_oversize_fold_test.go
new file mode 100644
index 0000000..f57f984
--- /dev/null
+++ b/internal/agent/active_oversize_fold_test.go
@@ -0,0 +1,121 @@
+package agent
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"reasonix/internal/event"
+	"reasonix/internal/provider"
+	"reasonix/internal/tool"
+)
+
+// A physical-overflow fold must be able to reclaim space even when the only
+// remaining foldable content is the active user turn itself. Without that,
+// a session whose current message already crosses the hard ceiling deadlocks
+// with "no foldable region remains" (CompactionNoop) and every request is
+// rejected. The active turn is folded only on the must-free path; the summary
+// prefix fitter still caps the request below the physical ceiling, and an
+// indivisible message that alone exceeds the ceiling fails with the precise
+// "no balanced prefix" error instead of wedging the session.
+func TestOverflowFoldsOversizedActiveTurn(t *testing.T) {
+	prov := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "You are a coding agent."})
+	for i := 0; i < 100; i++ {
+		msgs = append(msgs,
+			provider.Message{Role: provider.RoleUser, Content: "问题 " + strings.Repeat("x", 800)},
+			provider.Message{Role: provider.RoleAssistant, Content: "回答 " + strings.Repeat("y", 1600)},
+		)
+	}
+	// Large but individually foldable active paste: ~140k tokens, so history
+	// + active together cross the shared ceiling (window minus reserve).
+	msgs = append(msgs, provider.Message{Role: provider.RoleUser, Content: "大粘贴 " + strings.Repeat("z", 580_000), CreatedAt: 222})
+	sess := &Session{Messages: append([]provider.Message(nil), msgs...)}
+	a := New(prov, tool.NewRegistry(), sess, Options{
+		ContextWindow: 200_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+	a.activeTurnCreatedAt.Store(222)
+	src := a.estimatedVisibleRequestTokens(a.modelVisibleMessages())
+	hard := a.hardInputCeiling()
+	if src < hard {
+		t.Fatalf("probe setup: source %d below shared ceiling %d", src, hard)
+	}
+	outcome, err := a.compactToProjectionLocked(context.Background(), CompactionTriggerOverflow, "", foldRequest{force: true, mustFree: true})
+	if err != nil {
+		t.Fatalf("must-free fold with oversized active turn failed: %v", err)
+	}
+	if outcome == CompactionNoop {
+		t.Fatal("must-free fold returned noop; active turn must be foldable")
+	}
+	after := a.estimatedVisibleRequestTokens(a.modelVisibleMessages())
+	if after >= hard {
+		t.Fatalf("fold did not recover below hard ceiling: %d >= %d", after, hard)
+	}
+	if after >= src {
+		t.Fatalf("fold did not shrink the view: %d >= %d", after, src)
+	}
+}
+
+// An indivisible active message that alone exceeds the physical ceiling
+// cannot be summarized (the summary request would also overflow). The fold
+// pipeline reports CompactionNoop without wedging; the caller (foldContext →
+// summaryNoop) then recovers via truncation rescue for overflow triggers.
+// The contract pinned here is narrow: no hang, no error out of the fold
+// step itself, session left usable for the rescue path.
+func TestOverflowIndivisibleActiveTurnNoopsForRescue(t *testing.T) {
+	prov := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	msgs := []provider.Message{
+		{Role: provider.RoleSystem, Content: "You are a coding agent."},
+		{Role: provider.RoleUser, Content: "超大粘贴 " + strings.Repeat("z", 850_000), CreatedAt: 333},
+	}
+	sess := &Session{Messages: append([]provider.Message(nil), msgs...)}
+	a := New(prov, tool.NewRegistry(), sess, Options{
+		ContextWindow: 200_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+	a.activeTurnCreatedAt.Store(333)
+	src := a.estimatedVisibleRequestTokens(a.modelVisibleMessages())
+	if src < a.hardInputCeiling() {
+		t.Fatalf("probe setup: source %d below shared ceiling", src)
+	}
+	outcome, err := a.compactToProjectionLocked(context.Background(), CompactionTriggerOverflow, "", foldRequest{force: true, mustFree: true})
+	if err != nil {
+		t.Fatalf("indivisible oversized active turn errored: %v", err)
+	}
+	if outcome != CompactionNoop {
+		t.Fatalf("outcome = %v, want CompactionNoop for the truncation-rescue caller", outcome)
+	}
+}
+
+// Normal sessions keep protecting the active turn: folding older history must
+// not summarize the pending user message away.
+func TestActiveTurnStillProtectedOnPressureFold(t *testing.T) {
+	prov := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "You are a coding agent."})
+	for i := 0; i < 60; i++ {
+		msgs = append(msgs,
+			provider.Message{Role: provider.RoleUser, Content: "问题 " + strings.Repeat("x", 500)},
+			provider.Message{Role: provider.RoleAssistant, Content: "回答 " + strings.Repeat("y", 1000)},
+		)
+	}
+	msgs = append(msgs, provider.Message{Role: provider.RoleUser, Content: "当前问题 " + strings.Repeat("w", 60), CreatedAt: 444})
+	sess := &Session{Messages: append([]provider.Message(nil), msgs...)}
+	a := New(prov, tool.NewRegistry(), sess, Options{
+		ContextWindow: 200_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+	a.activeTurnCreatedAt.Store(444)
+	head, start, ok := a.planFoldRegion(a.modelVisibleMessages(), false, false)
+	if !ok {
+		t.Fatal("pressure fold should find a foldable region")
+	}
+	foldHasActive := false
+	for _, m := range a.modelVisibleMessages()[head:start] {
+		if m.CreatedAt == 444 {
+			foldHasActive = true
+		}
+	}
+	if foldHasActive {
+		t.Fatalf("pressure fold [%d:%d] must exclude the active turn", head, start)
+	}
+}
