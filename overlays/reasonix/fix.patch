+// admission step must not replace req.MaxTokens with the physical clip
+// value; the wire field must stay omitted so buildRequest can fall back to
+// the provider-configured max_output_tokens.
+func TestAdmitNoAutoClipForZenDeepSeek(t *testing.T) {
