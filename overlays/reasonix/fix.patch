+
+func TestDetectVendorOpencodeScope(t *testing.T) {
+	tests := []struct{ url, vendor string }{
+		{"https://opencode.ai/zen/v1", "opencode"},
+		{"https://opencode.ai/zen/v1/responses", "opencode"},
+		{"https://gateway.zenmux.ai/zen/v1", "opencode"},
+		{"http://127.0.0.1:8080/zen/v1", "opencode"},
+		// The Go relay keeps native zero caps: per-model reasoning contracts
+		// the CLI wire shape would strip.
+		{"https://opencode.ai/zen/go/v1", ""},
+		{"https://api.deepseek.com", "deepseek"},
+		{"https://example.com/v1", ""},
+	}
+	for _, test := range tests {
+		if got := DetectVendor(test.url); got != test.vendor {
+			t.Errorf("DetectVendor(%q) = %q, want %q", test.url, got, test.vendor)
+		}
+	}
+	caps := capabilitiesFor("opencode")
+	if !caps.stateless {
+		t.Errorf("opencode caps stateless = false, want true")
+	}
+	if caps.summary != summaryEcho {
+		t.Errorf("opencode caps summary = %v, want summaryEcho", caps.summary)
+	}
+	if !caps.omitReasoningID {
+		t.Errorf("opencode caps omitReasoningID = false, want true")
+	}
+	// Explicit config still wins over caps detection.
+	if got := (Config{BaseURL: "https://opencode.ai/zen/v1", Mode: "stateful"}).mode(); got != "stateful" {
+		t.Fatalf("explicit mode = %q, want stateful", got)
+	}
+}
+
+// zenResponsesGateway records the wire body/headers of a Responses request.
+type zenResponsesSeen struct {
+	headers http.Header
+	body    map[string]any
+}
+
+func zenResponsesClient(t *testing.T, seen *zenResponsesSeen) *client {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		seen.headers = r.Header.Clone()
+		_ = json.Unmarshal(raw, &seen.body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_1\",\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"ok\"}]}]}}\n\n")
+	}))
+	t.Cleanup(srv.Close)
+	p := New(Config{Name: "opencode-responses", BaseURL: "https://opencode.ai/zen/v1", Model: "muse-spark-1.3-contributor-free", Effort: "xhigh", APIKey: "public"})
+	c := p.(*client)
+	if !c.opencode {
+		t.Fatalf("client for opencode-responses/zen/v1 is not flagged opencode")
+	}
+	c.http = srv.Client()
+	// Keep the /responses suffix so the User-Agent pin selects the responses
+	// identity, exactly like the derived production request URL.
+	c.requestURL = srv.URL + "/responses"
+	return c
+}
+
+func TestZenResponsesWireShape(t *testing.T) {
+	var seen zenResponsesSeen
+	c := zenResponsesClient(t, &seen)
+	ch, err := c.Stream(t.Context(), provider.Request{
+		Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}},
+		Tools:    []provider.ToolSchema{{Name: "read_file", Description: "read"}, {Name: "bash", Description: "shell"}},
+	})
+	if err != nil {
+		t.Fatalf("Stream: %v", err)
+	}
+	for chunk := range ch {
+		if chunk.Type == provider.ChunkError {
+			t.Fatalf("stream error: %v", chunk.Err)
+		}
+	}
+	h := seen.headers
+	if got := h.Get("User-Agent"); got != provider.OpenCodeUserAgentResponses {
+		t.Fatalf("User-Agent = %q, want %q", got, provider.OpenCodeUserAgentResponses)
+	}
+	if got := h.Get("x-opencode-client"); got != "cli" {
+		t.Fatalf("x-opencode-client = %q, want cli", got)
+	}
+	if !strings.HasPrefix(h.Get("x-opencode-session"), "ses_") {
+		t.Fatalf("x-opencode-session = %q, want ses_ prefix", h.Get("x-opencode-session"))
+	}
+	if h.Get("Authorization") != "" {
+		t.Fatalf("Authorization = %q, want empty for anonymous zen", h.Get("Authorization"))
+	}
+	reasoning, _ := seen.body["reasoning"].(map[string]any)
+	if reasoning["summary"] != "auto" {
+		t.Fatalf("reasoning.summary = %v, want auto", reasoning["summary"])
+	}
+	if includes, _ := seen.body["include"].([]any); len(includes) != 1 || includes[0] != "reasoning.encrypted_content" {
+		t.Fatalf("include = %v, want [reasoning.encrypted_content]", seen.body["include"])
+	}
+	var names []string
+	for _, tool := range seen.body["tools"].([]any) {
+		names = append(names, tool.(map[string]any)["name"].(string))
+	}
+	if len(names) != 2 || names[0] != "read" || names[1] != "bash" {
+		t.Fatalf("wire tool names = %v, want [read bash]", names)
+	}
+	if seen.body["stream"] != true {
+		t.Fatalf("stream = %v, want true", seen.body["stream"])
+	}
+}
+
+func TestOpencodeReplayOmitsReasoningID(t *testing.T) {
+	caps := capabilitiesFor("opencode")
+	input := messagesToInput([]provider.Message{{
+		Role: provider.RoleAssistant, ReasoningContent: "thought",
+		ReasoningID: "rs_123", ReasoningStatus: "completed", Content: "done",
+	}}, false, false, caps)
+	raw, _ := json.Marshal(input)
+	s := string(raw)
+	if strings.Contains(s, `"id":"rs_123"`) {
+		t.Fatalf("replayed id for opencode: %s", s)
+	}
+	if !strings.Contains(s, `"status":"completed"`) {
+		t.Fatalf("status dropped for opencode: %s", s)
+	}
+	if !strings.Contains(s, "summary_text") {
+		t.Fatalf("no summary echo for opencode: %s", s)
+	}
+}
