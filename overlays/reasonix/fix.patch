+		svc:         agentServices{prov: prov, sink: event.Discard},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: 0}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("x", 7000)}}
+	a.sess.output.lastUsage.Store(&provider.Usage{PromptTokens: 7000})
+	a.setPromptTokenCalibration(7000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	req := provider.Request{Messages: msgs, MaxTokens: 0}
