+		{"zhipu", &client{zhipu: true, effort: "enabled", thinkingType: "enabled"}},
+		{"zhipu-disabled-config", &client{zhipu: true, effort: "enabled", thinkingType: "disabled"}},
+		{"longcat", &client{longcat: true, effort: "enabled"}},
