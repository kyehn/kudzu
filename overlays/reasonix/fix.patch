diff --git a/internal/agent/summary_capacity_test.go b/internal/agent/summary_capacity_test.go
new file mode 100644
index 0000000..dc4a805
--- /dev/null
+++ b/internal/agent/summary_capacity_test.go
@@ -0,0 +1,105 @@
+package agent
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"reasonix/internal/event"
+	"reasonix/internal/provider"
+	"reasonix/internal/tool"
+)
+
+// summaryFailingProvider fails every Stream with a capacity-style error, as
+// zen free-tier backends do when the request exceeds the real upstream limit
+// ("[1261] Prompt exceeds max length", stream EOFs, empty completions).
+type summaryFailingProvider struct {
+	sharedWindowTestProvider
+	errText string
+	calls   int
+}
+
+func (p *summaryFailingProvider) Stream(ctx context.Context, req provider.Request) (<-chan provider.Chunk, error) {
+	p.calls++
+	ch := make(chan provider.Chunk, 1)
+	ch <- provider.Chunk{Type: provider.ChunkError, Err: errors.New(p.errText)}
+	close(ch)
+	return ch, nil
+}
+
+// An unknown-window backend sends the whole fold on the first must-free
+// attempt (the configured window may be an underestimate). Once a capacity
+// failure halves the learned window, the fitter must cut the summary prefix
+// against the recalibrated hard ceiling instead of resending the same size.
+func TestSummaryPrefixCappedForUnknownWindow(t *testing.T) {
+	prov := &summaryFailingProvider{
+		sharedWindowTestProvider: sharedWindowTestProvider{shared: false},
+		errText:                  "opencode-zen: stream ended before completion: unexpected EOF",
+	}
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "You are a coding agent."})
+	for i := 0; i < 400; i++ {
+		msgs = append(msgs,
+			provider.Message{Role: provider.RoleUser, Content: strings.Repeat("q ", 300)},
+			provider.Message{Role: provider.RoleAssistant, Content: strings.Repeat("a ", 600)},
+		)
+	}
+	a := New(prov, tool.NewRegistry(), &Session{Messages: append([]provider.Message(nil), msgs...)}, Options{
+		ContextWindow: 30_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+	a.learnContextBudget(a.effectiveContextWindow()/2, 0, false)
+	head, end, ok := a.planFoldRegion(a.modelVisibleMessages(), true, true)
+	if !ok {
+		t.Fatal("expected a foldable region")
+	}
+	fitted := a.maximumSafeSummaryPrefixEnd(a.modelVisibleMessages(), head, end, "")
+	if fitted >= end {
+		t.Fatalf("shrunken-window summary prefix must be capped below the fold end: %d >= %d", fitted, end)
+	}
+	if fitted <= head {
+		t.Fatalf("fitted prefix collapsed to nothing: %d <= %d", fitted, head)
+	}
+}
+
+// A capacity-style summary failure must halve the learned window and retry
+// the fold against the recalibrated ceiling instead of failing the turn. The
+// halving stops at the floor and non-capacity errors never shrink.
+func TestCapacityErrorShrinksWindowAndRetries(t *testing.T) {
+	prov := &summaryFailingProvider{
+		sharedWindowTestProvider: sharedWindowTestProvider{shared: false},
+		errText: `opencode-zen: status 400: {"error":{"type":"server_error","message":"Error from provider (Console): Upstream request failed: [1261] Prompt exceeds max length"}}`,
+	}
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "You are a coding agent."})
+	for i := 0; i < 200; i++ {
+		msgs = append(msgs,
+			provider.Message{Role: provider.RoleUser, Content: strings.Repeat("q ", 200)},
+			provider.Message{Role: provider.RoleAssistant, Content: strings.Repeat("a ", 400)},
+		)
+	}
+	a := New(prov, tool.NewRegistry(), &Session{Messages: append([]provider.Message(nil), msgs...)}, Options{
+		ContextWindow: 1_000_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+	before := a.effectiveContextWindow()
+	_, err := a.contextManager().Prepare(context.Background(), ContextPreparePolicy{Trigger: CompactionTriggerOverflow})
+	if err == nil {
+		t.Fatal("provider always fails; Prepare must report an error")
+	}
+	after := a.effectiveContextWindow()
+	if after >= before {
+		t.Fatalf("capacity error must shrink the learned window: %d >= %d", after, before)
+	}
+	if prov.calls == 0 {
+		t.Fatal("summary endpoint was never called")
+	}
+
+	// Non-capacity errors must not move the window.
+	held := a.effectiveContextWindow()
+	if a.shrinkWindowOnSummaryCapacityError(errors.New("opencode-zen: status 429 rate limit exceeded")) {
+		t.Fatal("rate-limit errors must not shrink the window")
+	}
+	if a.effectiveContextWindow() != held {
+		t.Fatalf("window moved on a non-capacity error: %d -> %d", held, a.effectiveContextWindow())
+	}
+}
