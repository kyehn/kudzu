+
+func TestBuildRequestNoReasoningOpenCodeWireUnchanged(t *testing.T) {
+	// The opencode Zen wire never carries thinking/effort at all, so
+	// NoReasoning must be byte-identical to the default request — the
+	// compaction flag cannot perturb the fixed opencode body shape.
+	c := &client{name: "opencode", model: "deepseek-v4-flash-free", opencode: true}
+	msg := []provider.Message{{Role: provider.RoleUser, Content: "hi"}}
+	base := marshalBuildRequest(t, c, provider.Request{Messages: msg})
