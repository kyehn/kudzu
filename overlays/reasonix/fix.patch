+package openai
+
+import (
+	"regexp"
+	"testing"
+)
+
+func TestOpencodeIDFormat(t *testing.T) {
+	sesRe := regexp.MustCompile(`^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$`)
+	msgRe := regexp.MustCompile(`^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$`)
+	for i := 0; i < 200; i++ {
+		ses := opencodeCreate("ses", true)
+		msg := opencodeCreate("msg", false)
+		if !sesRe.MatchString(ses) {
+			t.Fatalf("bad session id %q", ses)
+		}
+		if !msgRe.MatchString(msg) {
+			t.Fatalf("bad message id %q", msg)
+		}
+	}
+}
+
+func TestOpencodeIDsMonotonic(t *testing.T) {
+	var lastSes string
+	for i := 0; i < 100; i++ {
+		ses := opencodeCreate("ses", true)
+		msg := opencodeCreate("msg", false)
+		if lastSes == "" {
+			lastSes = ses
+			continue
+		}
+		if ses == lastSes {
+			t.Fatalf("duplicate session id %q", ses)
+		}
+		lastSes = ses
+		_ = msg
+	}
+}
