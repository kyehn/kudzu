diff --git a/internal/agent/shared_ceiling_test.go b/internal/agent/shared_ceiling_test.go
new file mode 100644
index 000000000..609c6bb6e
--- /dev/null
+++ b/internal/agent/shared_ceiling_test.go
@@ -0,0 +1,111 @@
+package agent
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"reasonix/internal/event"
+	"reasonix/internal/provider"
+	"reasonix/internal/tool"
+)
+
+// The physical input ceiling is window minus protocol reserve on every window
+// mode; reply budgets are resolved independently at send time by the output
+// admission step, so shared and independent windows share the same ceiling.
+func TestHardInputCeilingSharedWindow(t *testing.T) {
+	shared := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	a := New(shared, tool.NewRegistry(), &Session{Messages: []provider.Message{{Role: provider.RoleUser, Content: "x"}}}, Options{
+		ContextWindow: 200_000,
+	}, event.Discard)
+	const want = 200_000 - protocolReserveTokens
+	if got := a.hardInputCeiling(); got != want {
+		t.Fatalf("shared ceiling = %d, want %d", got, want)
+	}
+
+	indep := &recordingProvider{reply: "x"}
+	b := New(indep, tool.NewRegistry(), &Session{Messages: []provider.Message{{Role: provider.RoleUser, Content: "x"}}}, Options{
+		ContextWindow: 200_000,
+	}, event.Discard)
+	if got, want := b.hardInputCeiling(), 200_000-protocolReserveTokens; got != want {
+		t.Fatalf("independent ceiling = %d, want %d", got, want)
+	}
+}
+
+// A shared-window session that has grown past the physical input ceiling must
+// compact below it (with room for an answer) instead of wedging at the limit.
+func TestSharedWindowOverflowCompactsBelowCeiling(t *testing.T) {
+	prov := &sharedWindowTestProvider{shared: true, budget: 128 * 1024}
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "sys"})
+	for i := 0; i < 460; i++ {
+		msgs = append(msgs, provider.Message{Role: provider.RoleUser, Content: strings.Repeat("turntext ", 60) + "u"})
+		msgs = append(msgs, provider.Message{Role: provider.RoleAssistant, Content: strings.Repeat("worktext ", 140)})
+	}
+	sess := &Session{Messages: append([]provider.Message(nil), msgs...)}
+	a := New(prov, tool.NewRegistry(), sess, Options{
+		ContextWindow: 200_000, CompactRatio: 0.7, MaxOutputTokens: 128_000,
+	}, event.Discard)
+
+	src := a.estimatedVisibleRequestTokens(msgs)
+	hard := a.hardInputCeiling()
+	if src < hard {
+		t.Fatalf("probe setup: source %d did not exceed shared ceiling %d", src, hard)
+	}
+	if _, err := a.compactToProjectionLocked(context.Background(), CompactionTriggerOverflow, "", true, true, false); err != nil {
+		t.Fatalf("overflow compaction failed at source %d: %v", src, err)
+	}
+	visible := a.modelVisibleMessages()
+	after := a.estimatedVisibleRequestTokens(visible)
+	if after >= hard {
+		t.Fatalf("projection %d tokens still at/above shared ceiling %d", after, hard)
+	}
+	if after >= src {
+		t.Fatalf("projection %d tokens did not shrink the view (source %d)", after, src)
+	}
+}
+
+// zenDeepSeekPolicyProvider simulates the patched openCodeZenDeepSeek policy:
+// shared-window budget with zero AutoOutputTokens so the gateway never sees
+// an auto-budget that becomes an oversized max_tokens on the wire.
+type zenDeepSeekPolicyProvider struct{}
+
+func (zenDeepSeekPolicyProvider) Name() string { return "opencode-zen" }
+func (zenDeepSeekPolicyProvider) Stream(_ context.Context, _ provider.Request) (<-chan provider.Chunk, error) {
+	ch := make(chan provider.Chunk, 1)
+	close(ch)
+	return ch, nil
+}
+func (zenDeepSeekPolicyProvider) ContextBudgetPolicy() provider.ContextBudgetPolicy {
+	return provider.ContextBudgetPolicy{
+		WindowMode: provider.ContextWindowShared,
+		LimitMode:  provider.OutputLimitOmitWhenSafe,
+		// AutoOutputTokens and MaxOutputTokens deliberately zero: the Zen
+		// gateway does not understand DeepSeek's native omit-for-default
+		// semantics, so any auto budget that survives into a physical clip
+		// would become an explicit max_tokens the gateway rejects.
+	}
+}
+
+// When agent.maxOutputTokens is zero (the boot path does not pass one) the
+// admission step must not replace req.MaxTokens with the physical clip
+// value; the wire field must stay omitted so buildRequest can fall back to
+// the provider-configured max_output_tokens.
+func TestAdmitNoAutoClipForZenDeepSeek(t *testing.T) {
+	prov := zenDeepSeekPolicyProvider{}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 200_000, maxOutputTokens: 0},
+		svc:         agentServices{prov: prov, sink: event.Discard},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: 0}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("x", 7000)}}
+	a.sess.output.lastUsage.Store(&provider.Usage{PromptTokens: 7000})
+	a.setPromptTokenCalibration(7000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	req := provider.Request{Messages: msgs, MaxTokens: 0}
+	if err := a.applyAdmissionToRequest(&req); err != nil {
+		t.Fatalf("admission failed: %v", err)
+	}
+	if req.MaxTokens != 0 {
+		t.Fatalf("req.MaxTokens = %d, want 0 (auto budget must not clip to physical)", req.MaxTokens)
+	}
+}
