diff --git a/internal/base/netclient/opencode_tls.go b/internal/base/netclient/opencode_tls.go
new file mode 100644
index 0000000..d01b28a
--- /dev/null
+++ b/internal/base/netclient/opencode_tls.go
@@ -0,0 +1,140 @@
+package netclient
+
+import (
+	"context"
+	"net"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+// OpenCodeClientHelloSpec reproduces the TLS ClientHello emitted by the opencode
+// CLI (Bun/BoringSSL, verified against opencode-ai 1.18.32 wire behavior) against a
+// hostname endpoint:
+//
+//	JA3  : 7c60c49b23c5483a84737c3ae0a5cd3c
+//	JA4  : t13dh1171109_bbc337f0a232_e192d0c6fe3c
+//
+// The extension order matches BoringSSL's fixed layout (server_name first;
+// empty for IP literals). supported_groups leads with X25519MLKEM768 (0x11ec)
+// exactly as captured — it is Bun's post-quantum hybrid group, not GREASE —
+// followed by X25519/P-256/P-384; key shares cover MLKEM768 (hybrid share) plus
+// an X25519 fallback, mirroring BoringSSL, so the server never needs a
+// HelloRetryRequest. ALPN is http/1.1-only — the real CLI never offers h2,
+// even with SNI, so neither do we: offering h2 makes Cloudflare negotiate it
+// while Go's http.Transport cannot speak h2 over this utls connection,
+// killing every request on a dead connection.
+// OpenCodeClientHelloSpec is the template for the opencode ClientHello. It is
+// mutable: ApplyPreset fills in the generated X25519 key share, so a fresh copy
+// (openCodeClientHelloSpec) must be used for every connection instead of this
+// shared value, or the second handshake reuses stale key material.
+var OpenCodeClientHelloSpec = utls.ClientHelloSpec{
+	CipherSuites: []uint16{
+		utls.TLS_AES_128_GCM_SHA256,                        // 0x1301
+		utls.TLS_AES_256_GCM_SHA384,                        // 0x1302
+		utls.TLS_CHACHA20_POLY1305_SHA256,                  // 0x1303
+		utls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,       // 0xc02b
+		utls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,         // 0xc02f
+		utls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,       // 0xc02c
+		utls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,         // 0xc030
+		utls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, // 0xcca9
+		utls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,   // 0xcca8
+		utls.TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA,          // 0xc009
+		utls.TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA,            // 0xc013
+		utls.TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA,          // 0xc00a
+		utls.TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA,            // 0xc014
+		utls.TLS_RSA_WITH_AES_128_GCM_SHA256,               // 0x009c
+		utls.TLS_RSA_WITH_AES_256_GCM_SHA384,               // 0x009d
+		utls.TLS_RSA_WITH_AES_128_CBC_SHA,                  // 0x002f
+		utls.TLS_RSA_WITH_AES_256_CBC_SHA,                  // 0x0035
+	},
+	CompressionMethods: []uint8{0},
+	Extensions: []utls.TLSExtension{
+		&utls.SNIExtension{}, // ServerName filled from config; empty for IP literals
+		&utls.ExtendedMasterSecretExtension{},
+		&utls.RenegotiationInfoExtension{Renegotiation: utls.RenegotiateOnceAsClient},
+		&utls.SupportedCurvesExtension{Curves: []utls.CurveID{utls.X25519MLKEM768, utls.CurveX25519, utls.CurveP256, utls.CurveP384}},
+		&utls.SupportedPointsExtension{SupportedPoints: []uint8{0}},
+		&utls.SessionTicketExtension{},
+		&utls.ALPNExtension{AlpnProtocols: []string{"http/1.1"}},
+		&utls.StatusRequestExtension{},
+		&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+			utls.ECDSAWithP256AndSHA256, // 0x0403
+			utls.PSSWithSHA256,          // 0x0804
+			utls.PKCS1WithSHA256,        // 0x0401
+			utls.ECDSAWithP384AndSHA384, // 0x0503
+			utls.PSSWithSHA384,          // 0x0805
+			utls.PKCS1WithSHA384,        // 0x0501
+			utls.PSSWithSHA512,          // 0x0806
+			utls.PKCS1WithSHA512,        // 0x0601
+			utls.PKCS1WithSHA1,          // 0x0201
+		}},
+		&utls.SCTExtension{},
+		&utls.KeyShareExtension{KeyShares: []utls.KeyShare{{Group: utls.X25519MLKEM768}, {Group: utls.CurveX25519}}},
+		&utls.PSKKeyExchangeModesExtension{Modes: []uint8{1}}, // pskModeDHE
+		&utls.SupportedVersionsExtension{Versions: []uint16{utls.VersionTLS13, utls.VersionTLS12}},
+	},
+	TLSVersMin: utls.VersionTLS12,
+	TLSVersMax: utls.VersionTLS13,
+}
+
+// openCodeClientHelloSpec returns a fresh copy of OpenCodeClientHelloSpec.
+// ApplyPreset stores the generated X25519 key share into the spec's
+// KeyShareExtension, so every dial needs its own copy; reusing the shared
+// template corrupts the key material of every subsequent handshake.
+func openCodeClientHelloSpec() *utls.ClientHelloSpec {
+	spec := OpenCodeClientHelloSpec
+	spec.CipherSuites = append([]uint16(nil), OpenCodeClientHelloSpec.CipherSuites...)
+	spec.CompressionMethods = append([]uint8(nil), OpenCodeClientHelloSpec.CompressionMethods...)
+	spec.Extensions = make([]utls.TLSExtension, len(OpenCodeClientHelloSpec.Extensions))
+	for i, ext := range OpenCodeClientHelloSpec.Extensions {
+		switch e := ext.(type) {
+		case *utls.KeyShareExtension:
+			ks := *e
+			ks.KeyShares = append([]utls.KeyShare(nil), e.KeyShares...)
+			spec.Extensions[i] = &ks
+		default:
+			spec.Extensions[i] = ext
+		}
+	}
+	return &spec
+}
+
+// OpenCodeDialTLS returns a DialTLSContext hook that handshakes with the
+// opencode ClientHello spec. It is used by the openai provider when it detects
+// an opencode endpoint, so the transport speaks the exact BoringSSL shape the
+// real CLI presents instead of Go's default ClientHello.
+func OpenCodeDialTLS(dialTimeout, keepAlive, handshakeTimeout time.Duration) func(ctx context.Context, network, addr string) (net.Conn, error) {
+	d := &net.Dialer{Timeout: dialTimeout, KeepAlive: keepAlive}
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		raw, err := d.DialContext(ctx, network, addr)
+		if err != nil {
+			return nil, err
+		}
+		host, _, err := net.SplitHostPort(addr)
+		if err != nil {
+			host = addr
+		}
+		tlsCfg := &utls.Config{
+			ServerName: host,
+			NextProtos: []string{"http/1.1"},
+		}
+		uconn := utls.UClient(raw, tlsCfg, utls.HelloCustom)
+		if err := uconn.ApplyPreset(openCodeClientHelloSpec()); err != nil {
+			raw.Close()
+			return nil, err
+		}
+		handshakeCtx := ctx
+		cancel := func() {}
+		if handshakeTimeout > 0 {
+			handshakeCtx, cancel = context.WithTimeout(ctx, handshakeTimeout)
+		}
+		err = uconn.HandshakeContext(handshakeCtx)
+		cancel()
+		if err != nil {
+			raw.Close()
+			return nil, err
+		}
+		return uconn, nil
+	}
+}
diff --git a/internal/contract/provider/opencode_cli.go b/internal/contract/provider/opencode_cli.go
new file mode 100644
index 0000000..2390118
--- /dev/null
+++ b/internal/contract/provider/opencode_cli.go
@@ -0,0 +1,290 @@
+package provider
+
+import (
+	"crypto/rand"
+	"crypto/sha1"
+	"encoding/hex"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+// OpenCode wire User-Agents pinned per endpoint family (opencode-ai 1.18.32,
+// verified via local capture): provider-utils ships a different version per
+// wire kind, so the target URL names which pin goes out. request.ts uses
+// `opencode/${Version}` as the base; the ai-sdk provider-utils fetch wrapper
+// appends the suffix on the wire. The Zen free tier rejects anonymous traffic
+// that does not look like the CLI, so every opencode Zen adapter must stamp
+// these — not Go's default UA.
+const OpenCodeVersion = "1.18.32"
+
+const (
+	OpenCodeUserAgentOpenAI    = "opencode/1.18.32 ai-sdk/provider-utils/4.0.23 runtime/bun/1.3.14"
+	OpenCodeUserAgentResponses = "opencode/1.18.32 ai-sdk/provider-utils/4.0.40 runtime/bun/1.3.14"
+	OpenCodeUserAgentAnthropic = "opencode/1.18.32 ai-sdk/provider-utils/4.0.46 runtime/bun/1.3.14"
+)
+
+// OpenCodeUserAgentFor returns the CLI User-Agent for the endpoint
+// targetURL names: /messages → anthropic pin, /responses → responses pin,
+// everything else (chat/completions, models) → openai pin.
+func OpenCodeUserAgentFor(targetURL string) string {
+	if strings.Contains(targetURL, "/messages") {
+		return OpenCodeUserAgentAnthropic
+	}
+	if strings.Contains(targetURL, "/responses") {
+		return OpenCodeUserAgentResponses
+	}
+	return OpenCodeUserAgentOpenAI
+}
+
+// IsOpenCode reports whether a provider speaks the opencode CLI wire shape
+// (CLI TLS fingerprint, x-opencode-* headers, fixed body key order). It
+// matches the generated config's models.dev names ("opencode", plus
+// "opencode-zen"/"opencode-responses" kept for older configs), the v2
+// zenmux.ai gateway host, and the v1 Zen path (/zen/v1, which also survives a
+// local capture proxy that rewrites base_url to an IP). The OpenCode Go relay
+// (names "opencode-go*", paths /zen/go*) is deliberately excluded: it is a
+// plain OpenAI-compatible endpoint with per-model reasoning contracts (e.g.
+// kimi-k3 reasoning_effort) that the CLI wire shape would strip.
+func IsOpenCode(name, baseURL string) bool {
+	switch strings.ToLower(strings.TrimSpace(name)) {
+	case "opencode", "opencode-zen", "opencode-responses":
+		return true
+	}
+	u, err := url.Parse(baseURL)
+	if err != nil {
+		return false
+	}
+	host := strings.ToLower(u.Hostname())
+	if host == "zenmux.ai" || strings.HasSuffix(host, ".zenmux.ai") {
+		return true
+	}
+	return strings.Contains(u.EscapedPath(), "/zen/v1")
+}
+
+// OpenCodeSessionID returns a fresh CLI-shaped session ID: the descending
+// encoding via SessionID.create, fixed per client instance and stamped on
+// x-opencode-session (and prompt_cache_key) for the whole session.
+func OpenCodeSessionID() string {
+	return OpenCodeCreate("ses", true)
+}
+
+// OpenCodeRequestID returns a fresh CLI-shaped per-request ID: the ascending
+// encoding via SessionMessage.create, stamped on x-opencode-request for each
+// request (packages/opencode/src/session/llm/request.ts, v1.18.32).
+func OpenCodeRequestID() string {
+	return OpenCodeCreate("msg", false)
+}
+
+// OpenCodeProjectID resolves the CLI's x-opencode-project for the current
+// working directory (packages/core/src/project.ts, v1.18.32): remote →
+// cached → root, sha1("git-remote:<host/path>"), "global" fallback.
+func OpenCodeProjectID() string {
+	cwd, err := os.Getwd()
+	if err != nil {
+		return "global"
+	}
+	return openCodeProjectIDFor(cwd)
+}
+
+func openCodeGitOut(cwd string, args ...string) string {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = cwd
+	out, err := cmd.Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func openCodeNormalizeRemote(value string) string {
+	trimmed := strings.TrimSpace(value)
+	if trimmed == "" {
+		return ""
+	}
+	parts := func(host, name string) string {
+		pathname := name
+		for strings.HasPrefix(pathname, "/") {
+			pathname = strings.TrimPrefix(pathname, "/")
+		}
+		pathname = strings.TrimSuffix(strings.TrimSuffix(pathname, "/"), ".git")
+		pathname = strings.TrimSuffix(pathname, "/")
+		// Mirror the TS chain: strip leading slashes, ".git" suffix, then
+		// trailing slashes (handles ".git/" too).
+		for strings.HasSuffix(pathname, "/") {
+			pathname = strings.TrimSuffix(pathname, "/")
+		}
+		if host == "" || pathname == "" {
+			return ""
+		}
+		return strings.ToLower(host) + "/" + pathname
+	}
+	// Try URL form first (https://, ssh://, ...); file: URLs never qualify.
+	if strings.Contains(trimmed, "://") {
+		if u, err := url.Parse(trimmed); err == nil {
+			if u.Scheme == "file" {
+				return ""
+			}
+			if normalized := parts(u.Hostname(), u.Path); normalized != "" {
+				return normalized
+			}
+		}
+	}
+	// SCP-like syntax: [user@]host:path
+	if idx := strings.Index(trimmed, ":"); idx >= 0 {
+		before, after := trimmed[:idx], trimmed[idx+1:]
+		if !strings.Contains(before, "/") && after != "" {
+			host := before
+			if at := strings.LastIndex(host, "@"); at >= 0 {
+				host = host[at+1:]
+			}
+			if host != "" {
+				if normalized := parts(host, after); normalized != "" {
+					return normalized
+				}
+			}
+		}
+	}
+	return ""
+}
+
+func openCodeProjectIDFor(cwd string) string {
+	commonDirRaw := openCodeGitOut(cwd, "rev-parse", "--git-common-dir")
+	if commonDirRaw == "" {
+		return "global"
+	}
+	commonDir := commonDirRaw
+	if !filepath.IsAbs(commonDir) {
+		commonDir = filepath.Join(cwd, commonDir)
+	}
+	// 1. Remote URL first (highest priority).
+	if normalized := openCodeNormalizeRemote(openCodeGitOut(cwd, "remote", "get-url", "origin")); normalized != "" {
+		sum := sha1.Sum([]byte("git-remote:" + normalized))
+		return hex.EncodeToString(sum[:])
+	}
+	// 2. Cached ID from <common-dir>/opencode.
+	if data, err := os.ReadFile(filepath.Join(commonDir, "opencode")); err == nil {
+		if cached := strings.TrimSpace(string(data)); cached != "" {
+			return cached
+		}
+	}
+	// 3. First root commit hash, sorted lexicographically.
+	if roots := openCodeGitOut(cwd, "rev-list", "--max-parents=0", "HEAD"); roots != "" {
+		var list []string
+		for _, line := range strings.Split(roots, "\n") {
+			if trimmed := strings.TrimSpace(line); trimmed != "" {
+				list = append(list, trimmed)
+			}
+		}
+		if len(list) > 0 {
+			sort.Strings(list)
+			return list[0]
+		}
+	}
+	return "global"
+}
+
+// ApplyOpenCodeCLIHeaders stamps the opencode-specific headers onto a request
+// (packages/opencode/src/session/llm/request.ts, v1.18.32): opencode provider
+// → x-opencode-* only, with a fresh ascending msg_ request ID per call. The
+// x-opencode-* keys are written lowercase (like the real CLI) via direct map
+// assignment; Go writes header map keys verbatim, preserving the casing.
+// targetURL names the User-Agent pin (see OpenCodeUserAgentFor); callers pass
+// the request's own URL so each kind carries its CLI pin.
+func ApplyOpenCodeCLIHeaders(header http.Header, session, project, targetURL string) {
+	// Drop canonical-cased copies a config may have supplied so the lowercase
+	// keys below are the only ones that reach the wire.
+	header.Del("User-Agent")
+	header.Del("X-Opencode-Client")
+	header.Del("X-Opencode-Session")
+	header.Del("X-Opencode-Project")
+	header.Del("X-Opencode-Request")
+	header.Del("X-Session-Affinity")
+	header.Del("X-Session-Id")
+	if project == "" {
+		project = "global"
+	}
+	header.Set("User-Agent", OpenCodeUserAgentFor(targetURL))
+	header["x-opencode-client"] = []string{"cli"}
+	header["x-opencode-project"] = []string{project}
+	header["x-opencode-session"] = []string{session}
+	header["x-opencode-request"] = []string{OpenCodeRequestID()}
+}
+
+// Port of opencode's ID generator (packages/schema/src/identifier.ts):
+// 12 lowercase-hex chars of the 48-bit time+counter value (big-endian,
+// bitwise-NOT when descending) plus 14 chars of random base62 drawn as
+// random-byte % 62 over "0-9A-Za-z". Session IDs use the descending encoding
+// via SessionID.create; the counter resets every millisecond.
+//
+//   - session IDs use the descending encoding (time+counter bitwise-NOT) so they
+//     sort newest-first;
+//   - message IDs use the ascending encoding (bare time+counter).
+//
+// The 48-bit time component wraps every 2^36 ms (~2.2 years); decoding it for
+// assertions must account for that, exactly like opencode's own timestamp().
+const (
+	openCodeIDLength    = 26
+	openCodeIDTimeBytes = 6
+)
+
+const openCodeIDChars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+var (
+	openCodeIDMu      sync.Mutex
+	openCodeIDLastMS  int64
+	openCodeIDCounter uint64
+)
+
+// OpenCodeCreate mirrors id.ts create(): a monotonic per-millisecond counter is
+// folded into a 48-bit time+counter value, optionally descending (bitwise-NOT),
+// hex-encoded to 6 bytes, and padded with random base62 to a 26-char total.
+func OpenCodeCreate(prefix string, descending bool) string {
+	ms := time.Now().UnixMilli()
+
+	openCodeIDMu.Lock()
+	if ms != openCodeIDLastMS {
+		openCodeIDLastMS = ms
+		openCodeIDCounter = 0
+	}
+	openCodeIDCounter++
+	counter := openCodeIDCounter
+	openCodeIDMu.Unlock()
+
+	v := uint64(ms)*0x1000 + counter
+	if descending {
+		v = ^v
+	}
+	v &= 0xFFFF_FFFF_FFFF
+
+	timeBytes := [openCodeIDTimeBytes]byte{
+		byte(v >> 40),
+		byte(v >> 32),
+		byte(v >> 24),
+		byte(v >> 16),
+		byte(v >> 8),
+		byte(v),
+	}
+	hexPart := make([]byte, 12)
+	hex.Encode(hexPart, timeBytes[:])
+
+	return prefix + "_" + string(hexPart) + openCodeRandomBase62(openCodeIDLength-12)
+}
+
+func openCodeRandomBase62(n int) string {
+	buf := make([]byte, n)
+	if _, err := rand.Read(buf); err != nil {
+		panic("opencode: crypto/rand failed: " + err.Error())
+	}
+	out := make([]byte, n)
+	for i, b := range buf {
+		out[i] = openCodeIDChars[b%62]
+	}
+	return string(out)
+}
