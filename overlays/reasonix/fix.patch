+		{"opencode-go-deepseek", "https://opencode.ai/zen/go/v1", false},
+		{"opencode-go-responses", "https://opencode.ai/zen/go/v1", false},
+		{"opencode-zen-anthropic", "https://opencode.ai/zen", false},
