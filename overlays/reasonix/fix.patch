+// The OpenCode Go relay is a plain OpenAI-compatible endpoint with per-model
+// reasoning contracts: it must never take the CLI mimic path, even though its
+// names share the "opencode-" prefix. The CLI path is the models.dev names
+// plus the /zen/v1 gateway path (which also covers renames and IP proxies).
+func TestIsOpenCodeScope(t *testing.T) {
+	cases := []struct {
+		name, baseURL string
+		want          bool
+	}{
+		{"opencode", "https://opencode.ai/zen/v1", true},
+		{"opencode-zen", "https://opencode.ai/zen/v1", true},
+		{"opencode-responses", "https://opencode.ai/zen/v1", true},
+		{"custom-name", "https://opencode.ai/zen/v1/chat/completions", true},
