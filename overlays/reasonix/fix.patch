diff --git a/internal/agent/context_summary_admission_test.go b/internal/agent/context_summary_admission_test.go
new file mode 100644
index 0000000..14b5a7d
--- /dev/null
+++ b/internal/agent/context_summary_admission_test.go
@@ -0,0 +1,186 @@
+package agent
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"reasonix/internal/event"
+	"reasonix/internal/provider"
+	"reasonix/internal/tool"
+)
+
+// The compaction summarizer must be able to emit its full digest. Admission
+// never clips the summary's fixed output budget as long as the prompt fits
+// the configured window.
+func TestApplyAdmissionToSummaryRequestKeepsFixedOutputBudget(t *testing.T) {
+	prov := &sharedWindowTestProvider{budget: 128 * 1024, shared: true}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 100_000},
+		svc:         agentServices{prov: prov, sink: event.Discard},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: prov.budget}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("字", 50_000)}}
+	a.sess.output.lastUsage.Store(&provider.Usage{PromptTokens: 50_000})
+	a.setPromptTokenCalibration(50_000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	req := provider.Request{Messages: msgs, MaxTokens: summaryOutputMaxTokens}
+	if err := a.applyAdmissionToSummaryRequest(&req); err != nil {
+		t.Fatalf("summary admission: %v", err)
+	}
+	if req.MaxTokens != summaryOutputMaxTokens {
+		t.Fatalf("summary MaxTokens = %d, want fixed %d (unclipped)", req.MaxTokens, summaryOutputMaxTokens)
+	}
+}
+
+// Physical impossibility (no shared-window room at all) still requires
+// compaction, exactly like the ordinary request path.
+func TestApplyAdmissionToSummaryRequestRequiresPhysicalRoom(t *testing.T) {
+	prov := &sharedWindowTestProvider{budget: 128 * 1024, shared: true}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 100_000},
+		svc:         agentServices{prov: prov, sink: event.Discard},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: prov.budget}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("字", 101_000)}}
+	a.sess.output.lastUsage.Store(&provider.Usage{PromptTokens: 101_000})
+	a.setPromptTokenCalibration(101_000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	req := provider.Request{Messages: msgs, MaxTokens: summaryOutputMaxTokens}
+	if err := a.applyAdmissionToSummaryRequest(&req); !errors.Is(err, ErrCompactionRequired) {
+		t.Fatalf("summary admission err = %v, want ErrCompactionRequired", err)
+	}
+}
+
+// The configured window is the hard ceiling even when the gateway reports
+// more headroom: the physical budget, the reported window, and the
+// compaction ceilings all stay inside the configured 200k.
+func TestAdmitOutputBudgetClampsObservedWindowToConfigured(t *testing.T) {
+	prov := &sharedWindowTestProvider{budget: 128 * 1024, shared: true}
+	a := &Agent{
+		agentConfig: agentConfig{contextWindow: 200_000},
+		svc:         agentServices{prov: prov},
+		sess:        sessionRuntime{output: outputBudgetState{outputBudget: prov.budget}},
+	}
+	msgs := []provider.Message{{Role: provider.RoleUser, Content: strings.Repeat("x", 600_000)}}
+	a.setPromptTokenCalibration(100_000, requestCalibrationShapeOf(provider.Request{Messages: msgs}))
+	// The gateway proved a 1M window. The configured 200k must still gate
+	// every consumer: a larger observed window never widens the discipline.
+	a.sess.output.learned.Store(&learnedContextBudget{windowTokens: 1_048_576})
+	adm, err := a.admitOutputBudget(provider.Request{Messages: msgs, MaxTokens: 1_000_000})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if adm.PromptTokens < 99_000 || adm.PromptTokens > 101_000 {
+		t.Fatalf("calibrated prompt = %d, want ~100000", adm.PromptTokens)
+	}
+	wantPhysical := 200_000 - adm.PromptTokens - outputBudgetReserveForWindow(200_000)
+	if adm.PhysicalRemaining != wantPhysical {
+		t.Fatalf("physical = %d, want %d (configured window, not observed 1M)", adm.PhysicalRemaining, wantPhysical)
+	}
+	if adm.WindowTokens != 200_000 {
+		t.Fatalf("reported window = %d, want configured 200000", adm.WindowTokens)
+	}
+	if got := a.effectiveContextWindow(); got != 200_000 {
+		t.Fatalf("effective window = %d, want configured 200000 (observed 1M clamped)", got)
+	}
+	if got := a.hardInputCeiling(); got != 200_000-protocolReserveTokens {
+		t.Fatalf("hard ceiling = %d, want configured-based %d", got, 200_000-protocolReserveTokens)
+	}
+	// The provider's 131072 output cap cannot fit the configured 200k window
+	// with a 100k prompt: it must clip to the physical remaining budget.
+	if !adm.Clipped || adm.EffectiveOutputTokens != wantPhysical {
+		t.Fatalf("effective = %d clipped=%v, want clipped %d", adm.EffectiveOutputTokens, adm.Clipped, wantPhysical)
+	}
+}
+
+// The learned window is recorded raw but never widens consumers: the
+// configured window stays the ceiling, and only a learned window *smaller*
+// than the config binds.
+func TestLearnConfiguredWindowFromContextLimitClampedToConfig(t *testing.T) {
+	a := &Agent{agentConfig: agentConfig{contextWindow: 200_000}}
+	limit := &provider.ContextLimitError{WindowTokens: 1_048_576, CompletionTokens: 354_469}
+	a.learnConfiguredWindowFromContextLimit(limit, true)
+	if snap := a.sess.output.learned.Load(); snap == nil || snap.windowTokens != 1_048_576 || snap.completionBudget != 354_469 {
+		t.Fatalf("learned = %+v, want raw window 1048576 completion 354469", snap)
+	}
+	if got := a.effectiveContextWindow(); got != 200_000 {
+		t.Fatalf("effective window = %d, want configured 200000 (observed 1M clamped)", got)
+	}
+	// The observed completion budget only counts when output was omitted.
+	a.learnConfiguredWindowFromContextLimit(&provider.ContextLimitError{WindowTokens: 512_000, CompletionTokens: 99_000}, false)
+	if snap := a.sess.output.learned.Load(); snap == nil || snap.windowTokens != 512_000 || snap.completionBudget != 354_469 {
+		t.Fatalf("learned = %+v, want window 512000 completion still 354469", snap)
+	}
+	if got := a.effectiveContextWindow(); got != 200_000 {
+		t.Fatalf("effective window after shrink to 512k = %d, want configured 200000 (still clamped)", got)
+	}
+	// Only a real limit below the config binds.
+	a.learnConfiguredWindowFromContextLimit(&provider.ContextLimitError{WindowTokens: 50_000, CompletionTokens: 12_000}, true)
+	if got := a.effectiveContextWindow(); got != 50_000 {
+		t.Fatalf("effective window = %d, want real limit 50000", got)
+	}
+}
+
+func TestLearnConfiguredWindowFromContextLimitFallsBackToConfig(t *testing.T) {
+	a := &Agent{agentConfig: agentConfig{contextWindow: 200_000}}
+	a.learnConfiguredWindowFromContextLimit(&provider.ContextLimitError{}, false)
+	if snap := a.sess.output.learned.Load(); snap == nil || snap.windowTokens != 200_000 {
+		t.Fatalf("learned = %+v, want configured fallback 200000", snap)
+	}
+}
+
+// Regression for the real-world deadlock: with a conservative configured
+// window (200000) and a session that already dwarfs it, Prepare must converge
+// below the hard ceiling by folding iteratively. No gateway overflow ever
+// happened, so no learned window exists — the configured 200k is the ceiling,
+// and a single fold cannot reclaim enough in one step. Before the iterative
+// must-free loop this deadlocked with ErrCompactionRequired: the fold
+// candidate (system + digest + retained tail) was still at or above the
+// configured physical ceiling, so no projection could ever be accepted and
+// "no foldable region remains" was reported to the user.
+func TestFoldConvergesBelowConfiguredHardCeilingWithoutLearnedWindow(t *testing.T) {
+	for _, learned := range []bool{false, true} {
+		name := "no-learned-window"
+		if learned {
+			name = "learned-larger-window-clamped"
+		}
+		t.Run(name, func(t *testing.T) {
+			prov := &sharedWindowTestProvider{budget: 1_048_576, shared: true}
+			sess := NewSession("")
+			msgs := []provider.Message{{Role: provider.RoleSystem, Content: "You are a coding agent."}}
+			for i := 0; i < 350; i++ {
+				msgs = append(msgs,
+					provider.Message{Role: provider.RoleUser, Content: strings.Repeat("字", 600) + " question " + string(rune('a'+i%26))},
+					provider.Message{Role: provider.RoleAssistant, Content: strings.Repeat("answer content here ", 300)},
+				)
+			}
+			sess.Replace(msgs)
+			registry := tool.NewRegistry()
+			a := New(prov, registry, sess, Options{
+				ContextWindow:   200_000,
+				CompactRatio:    0.7,
+				MaxOutputTokens: 384_000,
+				Temperature:     0.25,
+			}, event.Discard)
+			est := a.estimatedVisibleRequestTokens(a.modelVisibleMessages())
+			if est < a.hardInputCeiling() {
+				t.Fatalf("estimate %d below configured hard ceiling %d; session too small", est, a.hardInputCeiling())
+			}
+			if learned {
+				a.learnConfiguredWindowFromContextLimit(&provider.ContextLimitError{
+					WindowTokens: 1_048_576, PromptTokens: est, RequestedTokens: est,
+				}, false)
+			}
+			prepared, err := a.contextManager().Prepare(context.Background(), ContextPreparePolicy{Trigger: CompactionTriggerPressure})
+			if err != nil {
+				t.Fatalf("Prepare must converge below the configured ceiling, got: %v", err)
+			}
+			if prepared.InputTokens >= a.hardInputCeiling() {
+				t.Fatalf("fold did not reclaim below hard ceiling: %d >= %d", prepared.InputTokens, a.hardInputCeiling())
+			}
+			if prepared.InputTokens >= est {
+				t.Fatalf("fold did not reduce the view: %d >= %d", prepared.InputTokens, est)
+			}
+		})
+	}
+}
