From 4d93a11a00000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kyehn <kyehn@users.noreply.github.com>
Date: Wed, 20 Aug 2026 05:20:00 +0000
Subject: [PATCH 8/8] agent, provider: shared-window input ceiling reserves reply budget

DeepSeek-class providers count prompt and completion against one window.
The opencode Zen gateway carries DeepSeek models on a generic OpenAI wire,
so their shared semantics were lost: the physical input ceiling only kept
window-protocolReserve, letting a session grow to the provider limit where
compaction candidates could no longer reduce the view and requests were
rejected with -32603. Treat Zen-carried DeepSeek models as shared-window
and make the agent's hard input ceiling leave the reply reserve out of the
input, so overflow compaction fires earlier and the summary request always
fits below the ceiling.
---
 internal/agent/compact.go                          | 11 ++++++--
 internal/agent/compact_threshold_test.go           |  4 +--
 internal/agent/context_summary_admission_test.go   |  4 +--
 internal/agent/shared_ceiling_test.go              | 112 +++++++++++++++++++++++++++++
 internal/provider/openai/oczen_shared_window_test.go | 51 +++++++++++++++++
 internal/provider/openai/output_budget.go          | 46 +++++++++++++++++++++-
 6 files changed, 209 insertions(+), 9 deletions(-)
diff --git a/internal/agent/compact.go b/internal/agent/compact.go
index bb92929..ceab5d6 100644
--- a/internal/agent/compact.go
+++ b/internal/agent/compact.go
@@ -87,14 +87,21 @@ func (a *Agent) compactTrigger() int {
 	return max(1, int(float64(window)*ratio))
 }
 
-// hardInputCeiling is a physical input-safety boundary, not another user
+// hardInputCeiling is the physical input-safety boundary, not another user
 // compaction threshold. Reply budgets are resolved independently at send time.
+// On a shared prompt+completion window (DeepSeek-style) the ceiling must leave
+// the reply reserve out of the input so the session never wedges one token
+// away from the provider limit with nowhere to put an answer.
 func (a *Agent) hardInputCeiling() int {
 	window := a.effectiveContextWindow()
 	if a == nil || window <= 0 {
 		return 0
 	}
-	return max(1, window-protocolReserveTokens)
+	ceiling := window - protocolReserveTokens
+	if sharesContextWindow(a.svc.prov) {
+		ceiling = window - outputBudgetReserve - protocolReserveTokens
+	}
+	return max(1, ceiling)
 }
 
 // recentTailBudget is the content-construction budget for the recent verbatim
