+
+// DeepSeek models behind the opencode Zen gateway keep their official shared
+// prompt+completion window even though the wire is generic OpenAI.
+func TestOpenCodeZenDeepSeekSharedWindow(t *testing.T) {
+	p, err := New(provider.Config{
+		Name: "opencode-zen", BaseURL: "https://opencode.ai/zen/v1",
+		Model: "deepseek-v4-flash-free",
+		Extra: map[string]any{
+			"reasoning_protocol": "openai",
+			"context_window":     200000,
+			"max_output_tokens":  128000,
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := p.(*client)
+	got := c.ContextBudgetPolicy()
+	if got.WindowMode != provider.ContextWindowShared {
+		t.Fatalf("opencode-zen DeepSeek window mode = %v, want shared", got.WindowMode)
+	}
+	if !c.SharesContextWindow() {
+		t.Fatal("opencode-zen DeepSeek must share the context window")
+	}
+}
+
+// A non-DeepSeek model on the same gateway must stay independent.
