+// share into the KeyShareExtension it is given. Sharing one spec across
+// connections corrupted every handshake after the first (second ClientHello
+// carried the first connection's stale key material). openCodeClientHelloSpec
+// must therefore return independent copies every call.
+func TestOpenCodeClientHelloSpecFresh(t *testing.T) {
+	a := openCodeClientHelloSpec()
+	b := openCodeClientHelloSpec()
+
+	var ksA, ksB *utls.KeyShareExtension
+	for _, e := range a.Extensions {
+		if x, ok := e.(*utls.KeyShareExtension); ok {
+			ksA = x
+		}
+	}
+	for _, e := range b.Extensions {
+		if x, ok := e.(*utls.KeyShareExtension); ok {
+			ksB = x
+		}
+	}
+	if ksA == nil || ksB == nil {
+		t.Fatal("missing KeyShareExtension in cloned spec")
+	}
+	if ksA == ksB {
+		t.Fatal("KeyShareExtension pointers must not be shared across clones")
+	}
+	if &ksA.KeyShares[0] == &ksB.KeyShares[0] {
+		t.Fatal("KeyShares slice backing arrays must not be shared across clones")
+	}
+
+	// Mutating one clone's key share must not leak into the other or the shared
+	// template (which, once corrupted, breaks the very next connection).
+	ksA.KeyShares[0].Data = []byte{1}
+	if len(ksB.KeyShares[0].Data) != 0 {
+		t.Fatal("key share mutation leaked across clones")
+	}
+	if len(OpenCodeClientHelloSpec.Extensions) == 0 {
+		t.Fatal("shared template must stay intact")
+	}
+	for _, e := range OpenCodeClientHelloSpec.Extensions {
+		if x, ok := e.(*utls.KeyShareExtension); ok && len(x.KeyShares[0].Data) != 0 {
+			t.Fatal("key share mutation leaked into shared OpenCodeClientHelloSpec template")
+		}
+	}
+}
+
+// TestOpenCodeClientHelloSpecHTTP11Only pins the ALPN to http/1.1-only,
+// exactly as the real CLI emits (verified v1.18.31; never offers h2, even with
+// SNI). Offering h2 makes Cloudflare negotiate it while Go cannot speak h2
+// over this utls connection, killing every request — never re-add h2 here.
+func TestOpenCodeClientHelloSpecHTTP11Only(t *testing.T) {
+	var alpns []string
+	for _, e := range OpenCodeClientHelloSpec.Extensions {
+		if alpn, ok := e.(*utls.ALPNExtension); ok {
+			alpns = alpn.AlpnProtocols
+		}
+	}
+	if len(alpns) != 1 || alpns[0] != "http/1.1" {
+		t.Fatalf("ClientHello ALPN = %q, want exactly [http/1.1]", alpns)
+	}
+	if got := openCodeClientHelloSpec(); len(got.Extensions) == 0 {
+		t.Fatal("cloned spec lost extensions")
+	}
+}
+
+// TestOpenCodeClientHelloSpecGroups pins supported_groups and key shares to
+// the CLI capture (v1.18.31, Bun/BoringSSL): X25519MLKEM768 (0x11ec, Bun's post-quantum hybrid group
+// — not GREASE) first, then X25519/P-256/P-384. Key shares cover MLKEM768 plus
+// an X25519 fallback, mirroring BoringSSL, so the server never needs a
+// HelloRetryRequest. Groups feed JA3 directly; dropping 0x11ec changes the
+// fingerprint (JA3 7c60c49b23c5483a84737c3ae0a5cd3c).
+func TestOpenCodeClientHelloSpecGroups(t *testing.T) {
+	var curves []utls.CurveID
+	var shares []utls.CurveID
+	for _, e := range OpenCodeClientHelloSpec.Extensions {
+		switch x := e.(type) {
+		case *utls.SupportedCurvesExtension:
+			curves = append([]utls.CurveID(nil), x.Curves...)
+		case *utls.KeyShareExtension:
+			for _, ks := range x.KeyShares {
+				shares = append(shares, ks.Group)
+			}
+		}
+	}
+	wantCurves := []utls.CurveID{utls.X25519MLKEM768, utls.CurveX25519, utls.CurveP256, utls.CurveP384}
+	if len(curves) != len(wantCurves) {
+		t.Fatalf("supported_groups = %v, want %v", curves, wantCurves)
+	}
+	for i := range wantCurves {
+		if curves[i] != wantCurves[i] {
+			t.Fatalf("supported_groups = %v, want %v", curves, wantCurves)
+		}
+	}
+	wantShares := []utls.CurveID{utls.X25519MLKEM768, utls.CurveX25519}
+	if len(shares) != len(wantShares) {
+		t.Fatalf("key shares = %v, want %v", shares, wantShares)
+	}
+	for i := range wantShares {
+		if shares[i] != wantShares[i] {
+			t.Fatalf("key shares = %v, want %v", shares, wantShares)
+		}
+	}
+}
diff --git a/internal/netclient/opencode_tls.go b/internal/netclient/opencode_tls.go
new file mode 100644
index 0000000..9bb3045
--- /dev/null
+++ b/internal/netclient/opencode_tls.go
@@ -0,0 +1,140 @@
+package netclient
+
+import (
+	"context"
+	"net"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+// OpenCodeClientHelloSpec reproduces the TLS ClientHello emitted by the opencode
+// CLI (Bun/BoringSSL, verified against opencode-ai 1.18.31 wire behavior) against a
+// hostname endpoint:
+//
+//	JA3  : 7c60c49b23c5483a84737c3ae0a5cd3c
+//	JA4  : t13dh1171109_bbc337f0a232_e192d0c6fe3c
+//
+// The extension order matches BoringSSL's fixed layout (server_name first;
+// empty for IP literals). supported_groups leads with X25519MLKEM768 (0x11ec)
+// exactly as captured — it is Bun's post-quantum hybrid group, not GREASE —
+// followed by X25519/P-256/P-384; key shares cover MLKEM768 (hybrid share) plus
+// an X25519 fallback, mirroring BoringSSL, so the server never needs a
+// HelloRetryRequest. ALPN is http/1.1-only — the real CLI never offers h2,
+// even with SNI, so neither do we: offering h2 makes Cloudflare negotiate it
+// while Go's http.Transport cannot speak h2 over this utls connection,
+// killing every request on a dead connection.
+// OpenCodeClientHelloSpec is the template for the opencode ClientHello. It is
+// mutable: ApplyPreset fills in the generated X25519 key share, so a fresh copy
+// (openCodeClientHelloSpec) must be used for every connection instead of this
+// shared value, or the second handshake reuses stale key material.
+var OpenCodeClientHelloSpec = utls.ClientHelloSpec{
+	CipherSuites: []uint16{
+		utls.TLS_AES_128_GCM_SHA256,                        // 0x1301
+		utls.TLS_AES_256_GCM_SHA384,                        // 0x1302
+		utls.TLS_CHACHA20_POLY1305_SHA256,                  // 0x1303
+		utls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,       // 0xc02b
+		utls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,         // 0xc02f
+		utls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,       // 0xc02c
+		utls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,         // 0xc030
+		utls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, // 0xcca9
+		utls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,   // 0xcca8
+		utls.TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA,          // 0xc009
+		utls.TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA,            // 0xc013
+		utls.TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA,          // 0xc00a
+		utls.TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA,            // 0xc014
+		utls.TLS_RSA_WITH_AES_128_GCM_SHA256,               // 0x009c
+		utls.TLS_RSA_WITH_AES_256_GCM_SHA384,               // 0x009d
+		utls.TLS_RSA_WITH_AES_128_CBC_SHA,                  // 0x002f
+		utls.TLS_RSA_WITH_AES_256_CBC_SHA,                  // 0x0035
+	},
+	CompressionMethods: []uint8{0},
+	Extensions: []utls.TLSExtension{
+		&utls.SNIExtension{}, // ServerName filled from config; empty for IP literals
+		&utls.ExtendedMasterSecretExtension{},
+		&utls.RenegotiationInfoExtension{Renegotiation: utls.RenegotiateOnceAsClient},
+		&utls.SupportedCurvesExtension{Curves: []utls.CurveID{utls.X25519MLKEM768, utls.CurveX25519, utls.CurveP256, utls.CurveP384}},
+		&utls.SupportedPointsExtension{SupportedPoints: []uint8{0}},
+		&utls.SessionTicketExtension{},
+		&utls.ALPNExtension{AlpnProtocols: []string{"http/1.1"}},
+		&utls.StatusRequestExtension{},
+		&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+			utls.ECDSAWithP256AndSHA256, // 0x0403
+			utls.PSSWithSHA256,          // 0x0804
+			utls.PKCS1WithSHA256,        // 0x0401
+			utls.ECDSAWithP384AndSHA384, // 0x0503
+			utls.PSSWithSHA384,          // 0x0805
+			utls.PKCS1WithSHA384,        // 0x0501
+			utls.PSSWithSHA512,          // 0x0806
+			utls.PKCS1WithSHA512,        // 0x0601
+			utls.PKCS1WithSHA1,          // 0x0201
+		}},
+		&utls.SCTExtension{},
+		&utls.KeyShareExtension{KeyShares: []utls.KeyShare{{Group: utls.X25519MLKEM768}, {Group: utls.CurveX25519}}},
+		&utls.PSKKeyExchangeModesExtension{Modes: []uint8{1}}, // pskModeDHE
+		&utls.SupportedVersionsExtension{Versions: []uint16{utls.VersionTLS13, utls.VersionTLS12}},
+	},
+	TLSVersMin: utls.VersionTLS12,
+	TLSVersMax: utls.VersionTLS13,
+}
+
+// openCodeClientHelloSpec returns a fresh copy of OpenCodeClientHelloSpec.
+// ApplyPreset stores the generated X25519 key share into the spec's
+// KeyShareExtension, so every dial needs its own copy; reusing the shared
+// template corrupts the key material of every subsequent handshake.
+func openCodeClientHelloSpec() *utls.ClientHelloSpec {
+	spec := OpenCodeClientHelloSpec
+	spec.CipherSuites = append([]uint16(nil), OpenCodeClientHelloSpec.CipherSuites...)
+	spec.CompressionMethods = append([]uint8(nil), OpenCodeClientHelloSpec.CompressionMethods...)
+	spec.Extensions = make([]utls.TLSExtension, len(OpenCodeClientHelloSpec.Extensions))
+	for i, ext := range OpenCodeClientHelloSpec.Extensions {
+		switch e := ext.(type) {
+		case *utls.KeyShareExtension:
+			ks := *e
+			ks.KeyShares = append([]utls.KeyShare(nil), e.KeyShares...)
+			spec.Extensions[i] = &ks
+		default:
+			spec.Extensions[i] = ext
+		}
+	}
+	return &spec
+}
+
+// OpenCodeDialTLS returns a DialTLSContext hook that handshakes with the
+// opencode ClientHello spec. It is used by the openai provider when it detects
+// an opencode endpoint, so the transport speaks the exact BoringSSL shape the
+// real CLI presents instead of Go's default ClientHello.
+func OpenCodeDialTLS(dialTimeout, keepAlive, handshakeTimeout time.Duration) func(ctx context.Context, network, addr string) (net.Conn, error) {
+	d := &net.Dialer{Timeout: dialTimeout, KeepAlive: keepAlive}
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		raw, err := d.DialContext(ctx, network, addr)
+		if err != nil {
+			return nil, err
+		}
+		host, _, err := net.SplitHostPort(addr)
+		if err != nil {
+			host = addr
+		}
+		tlsCfg := &utls.Config{
+			ServerName: host,
+			NextProtos: []string{"http/1.1"},
+		}
+		uconn := utls.UClient(raw, tlsCfg, utls.HelloCustom)
+		if err := uconn.ApplyPreset(openCodeClientHelloSpec()); err != nil {
+			raw.Close()
+			return nil, err
+		}
+		handshakeCtx := ctx
+		cancel := func() {}
+		if handshakeTimeout > 0 {
+			handshakeCtx, cancel = context.WithTimeout(ctx, handshakeTimeout)
+		}
+		err = uconn.HandshakeContext(handshakeCtx)
+		cancel()
+		if err != nil {
+			raw.Close()
+			return nil, err
+		}
+		return uconn, nil
+	}
+}
