@@ -0,0 +1,72 @@
+package openai
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"io"
+	"net/http"
+	"testing"
+
+	"github.com/andybalholm/brotli"
+	"github.com/klauspost/compress/zstd"
+)
+
+func TestDecompressBodyAllCodecs(t *testing.T) {
+	orig := "stream data: hello world\n" + `{"id":"x","object":"chat.completion.chunk"}`
+
+	cases := []struct {
+		name   string
+		enc    string
+		encode func() []byte
+	}{
+		{"identity", "", func() []byte { return []byte(orig) }},
+		{"gzip", "gzip", func() []byte {
+			var b bytes.Buffer
+			w := gzip.NewWriter(&b)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+		{"br", "br", func() []byte {
+			var b bytes.Buffer
+			w := brotli.NewWriter(&b)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+		{"zstd", "zstd", func() []byte {
+			var b bytes.Buffer
+			w, _ := zstd.NewWriter(&b)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+		{"raw-deflate", "deflate", func() []byte {
+			var b bytes.Buffer
+			w, _ := flate.NewWriter(&b, flate.DefaultCompression)
+			w.Write([]byte(orig))
+			w.Close()
+			return b.Bytes()
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			resp := &http.Response{Header: http.Header{}}
+			resp.Header.Set("Content-Encoding", tc.enc)
+			resp.Body = io.NopCloser(bytes.NewReader(tc.encode()))
+			rd, err := decompressBody(resp)
+			if err != nil {
+				t.Fatalf("decompressBody: %v", err)
+			}
+			got, err := io.ReadAll(rd)
+			rd.Close()
+			if err != nil {
+				t.Fatalf("read: %v", err)
+			}
+			if string(got) != orig {
+				t.Fatalf("mismatch:\n got  %q\n want %q", got, orig)
+			}
+		})
+	}
+}
diff --git a/internal/provider/openai/opencode_id.go b/internal/provider/openai/opencode_id.go
new file mode 100644
index 00000000..a6110472
--- /dev/null
+++ b/internal/provider/openai/opencode_id.go
@@ -0,0 +1,76 @@
+package openai
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"sync"
+	"time"
+)
+
+// Port of opencode's ID generator (packages/opencode/src/id/id.ts).
+//
+//   - session IDs use the descending encoding (time+counter bitwise-NOT) so they
+//     sort newest-first;
+//   - message IDs use the ascending encoding (bare time+counter).
+//
+// The 48-bit time component wraps every 2^36 ms (~2.2 years); decoding it for
+// assertions must account for that, exactly like opencode's own timestamp().
+const (
+	opencodeIDLength    = 26
+	opencodeIDTimeBytes = 6
+)
+
+const opencodeIDChars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+var (
+	opencodeIDMu      sync.Mutex
+	opencodeIDLastMS  int64
+	opencodeIDCounter uint64
+)
+
+// opencodeCreate mirrors id.ts create(): a monotonic per-millisecond counter is
+// folded into a 48-bit time+counter value, optionally descending (bitwise-NOT),
+// hex-encoded to 6 bytes, and padded with random base62 to a 26-char total.
+func opencodeCreate(prefix string, descending bool) string {
+	ms := time.Now().UnixMilli()
+
+	opencodeIDMu.Lock()
+	if ms != opencodeIDLastMS {
+		opencodeIDLastMS = ms
+		opencodeIDCounter = 0
+	}
+	opencodeIDCounter++
+	counter := opencodeIDCounter
+	opencodeIDMu.Unlock()
+
+	v := uint64(ms)*0x1000 + counter
+	if descending {
+		v = ^v
+	}
+	v &= 0xFFFF_FFFF_FFFF
+
+	timeBytes := [opencodeIDTimeBytes]byte{
+		byte(v >> 40),
+		byte(v >> 32),
+		byte(v >> 24),
+		byte(v >> 16),
+		byte(v >> 8),
+		byte(v),
+	}
+	hexPart := make([]byte, 12)
+	hex.Encode(hexPart, timeBytes[:])
+
+	return prefix + "_" + string(hexPart) + opencodeRandomBase62(opencodeIDLength-12)
+}
+
+func opencodeRandomBase62(n int) string {
+	buf := make([]byte, n)
+	if _, err := rand.Read(buf); err != nil {
+		panic("opencode: crypto/rand failed: " + err.Error())
+	}
+	out := make([]byte, n)
+	for i, b := range buf {
+		out[i] = opencodeIDChars[b%62]
+	}
+	return string(out)
+}
