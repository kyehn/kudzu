+package openai
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"reasonix/internal/provider"
+)
+
+// TestOpencodeStreamLocal exercises the full opencode wire path against a local
+// mock: request headers/body shape stamped by applyOpenCodeHeaders +
+// marshalOpenCodeRequest, and readStream parsing of an SSE stream using CRLF
+// line endings and multi-byte UTF-8 across a tool-call argument boundary.
+func TestOpencodeStreamLocal(t *testing.T) {
+	var gotReq *http.Request
+	var gotBody []byte
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotReq = r
+		gotBody, _ = io.ReadAll(r.Body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		// CRLF delimited, UTF-8 multi-byte split across tool-call arg deltas
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}\r\n\r\n")
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"echo 中文\\\"\"}}]}}]}\r\n\r\n")
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"}\"}}]}}]}\r\n\r\n")
+		io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"content\":\"完成\"}}]}\r\n\r\n")
+		io.WriteString(w, "data: [DONE]\r\n\r\n")
+	}))
+	defer srv.Close()
+
+	p, err := New(provider.Config{Name: "opencode-zen", BaseURL: srv.URL, Model: "mimo-v2.5-free", APIKey: "public"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	ch, err := p.Stream(context.Background(), provider.Request{
+		Messages: []provider.Message{{Role: provider.RoleUser, Content: "hi"}},
+	})
+	if err != nil {
+		t.Fatalf("Stream: %v", err)
+	}
+	var text strings.Builder
+	var tool *provider.ToolCall
+	for c := range ch {
+		switch c.Type {
+		case provider.ChunkError:
+			t.Fatalf("stream error: %v", c.Err)
+		case provider.ChunkText:
+			text.WriteString(c.Text)
+		case provider.ChunkToolCallStart, provider.ChunkToolCallArgsDelta:
+			if tool == nil || c.ToolCall.Name != "" {
+				tool = c.ToolCall
+			}
+		case provider.ChunkToolCall:
+			tool = c.ToolCall
+		}
+	}
+
+	// Request wire shape
+	if gotReq == nil {
+		t.Fatal("server saw no request")
+	}
+	if got := gotReq.Header.Get("User-Agent"); got != opencodeUserAgent {
+		t.Errorf("User-Agent = %q", got)
+	}
+	if got := gotReq.Header.Get("Accept-Encoding"); got != "gzip, deflate, br, zstd" {
+		t.Errorf("Accept-Encoding = %q", got)
+	}
+	for _, k := range []string{"x-opencode-client", "x-opencode-project", "x-opencode-request", "x-opencode-session"} {
+		if got := gotReq.Header.Get(k); got == "" {
+			t.Errorf("missing header %s", k)
+		}
+	}
+	var wire struct {
+		Keys []string
+	}
+	var top map[string]any
+	if err := json.Unmarshal(gotBody, &top); err != nil {
+		t.Fatalf("body: %v", err)
+	}
+	var order []string
+	for k := range top {
+		order = append(order, k)
+	}
+	_ = wire
+	if len(top) == 0 {
+		t.Error("empty body")
+	}
+	fmt.Printf("  body keys: %v\n", order)
+
+	// Stream output
+	if text.String() != "完成" {
+		t.Errorf("text = %q, want 完成", text.String())
+	}
+	if tool == nil || tool.Name != "bash" || tool.Arguments != `{"command":"echo 中文"}` {
+		t.Errorf("tool = %+v, want bash with UTF-8 args", tool)
+	} else {
+		fmt.Printf("  tool parsed OK: %s %s\n", tool.Name, tool.Arguments)
+	}
+}
