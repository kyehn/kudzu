@@ -0,0 +1,36 @@
+package openai
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestOpencodeCreateConcurrentUnique(t *testing.T) {
+	var wg sync.WaitGroup
+	seen := sync.Map{}
+	dups := make(chan string, 16)
+	for g := 0; g < 16; g++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 1000; i++ {
+				id := opencodeCreate("msg", false)
+				if _, loaded := seen.LoadOrStore(id, true); loaded {
+					select {
+					case dups <- id:
+					default:
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	close(dups)
+	n := 0
+	for d := range dups {
+		t.Errorf("duplicate id %q", d)
+		n++
+	}
+	fmt.Printf("concurrent unique check: 16000 ids, %d duplicates\n", n)
+}
