diff --git a/internal/provider/openai/opencode.go b/internal/provider/openai/opencode.go
new file mode 100644
index 00000000..b2cde1c1
--- /dev/null
+++ b/internal/provider/openai/opencode.go
@@ -0,0 +1,111 @@
+package openai
+
+import (
+	"compress/flate"
+	"compress/gzip"
+	"encoding/json"
+	"io"
+	"maps"
+	"net/http"
+	"strings"
+
+	"github.com/andybalholm/brotli"
+	"github.com/klauspost/compress/zstd"
+)
+
+// Wire constants captured from the real opencode CLI (v1.18.18) so a reasonix
+// request against an opencode Zen endpoint is indistinguishable from the CLI's.
+const (
+	opencodeUserAgent      = "opencode/1.18.18 ai-sdk/provider-utils/4.0.23 runtime/bun/1.3.14"
+	opencodeAcceptEncoding = "gzip, deflate, br, zstd"
+)
+
+// applyOpenCodeHeaders stamps the opencode-specific headers onto a request.
+// The x-opencode-* keys are written lowercase (like the real CLI) via direct
+// map assignment; Go writes header map keys verbatim, preserving the casing.
+// Session IDs are fixed per client instance; request IDs are generated fresh
+// per HTTP request.
+func (c *client) applyOpenCodeHeaders(h http.Header) {
+	if !c.opencode {
+		return
+	}
+	// Drop canonical-cased copies a config may have supplied so the lowercase
+	// keys below are the only ones that reach the wire.
+	h.Del("User-Agent")
+	h.Del("X-Opencode-Client")
+	h.Del("X-Opencode-Session")
+	h.Del("X-Opencode-Request")
+	h.Del("X-Opencode-Project")
+	h.Set("Accept", "*/*")
+	h.Set("User-Agent", opencodeUserAgent)
+	h.Set("Accept-Encoding", opencodeAcceptEncoding)
+	h["x-opencode-client"] = []string{"cli"}
+	h["x-opencode-project"] = []string{"global"}
+	h["x-opencode-request"] = []string{opencodeCreate("msg", false)}
+	h["x-opencode-session"] = []string{c.opencodeSession}
+}
+
+// openCodeRequest emits the opencode body key order exactly as the CLI sends it:
+// model, max_tokens, messages, tools, tool_choice, stream, stream_options.
+type openCodeRequest struct {
+	Model         string         `json:"model"`
+	MaxTokens     int            `json:"max_tokens,omitempty"`
+	Messages      []chatMessage  `json:"messages"`
+	Tools         []chatTool     `json:"tools,omitempty"`
+	ToolChoice    string         `json:"tool_choice,omitempty"`
+	Stream        bool           `json:"stream"`
+	StreamOptions *streamOptions `json:"stream_options,omitempty"`
+	ExtraBody     map[string]any `json:"-"`
+}
+
+func marshalOpenCodeRequest(r chatRequest) ([]byte, error) {
+	wire := openCodeRequest{
+		Model:         r.Model,
+		MaxTokens:     r.MaxTokens,
+		Messages:      r.Messages,
+		Tools:         r.Tools,
+		ToolChoice:    r.ToolChoice,
+		Stream:        r.Stream,
+		StreamOptions: r.StreamOptions,
+		ExtraBody:     r.ExtraBody,
+	}
+	raw, err := json.Marshal(wire)
+	if err != nil {
+		return nil, err
+	}
+	if len(wire.ExtraBody) == 0 {
+		return raw, nil
+	}
+	var body map[string]any
+	if err := json.Unmarshal(raw, &body); err != nil {
+		return nil, err
+	}
+	maps.Copy(body, cleanExtraBody(wire.ExtraBody))
+	return json.Marshal(body)
+}
+
+// decompressBody unwraps the response body according to Content-Encoding.
+// The opencode header Accept-Encoding: gzip, deflate, br, zstd disables Go's
+// transparent gzip handling, so the SSE parser must decode manually.
+func decompressBody(resp *http.Response) (io.ReadCloser, error) {
+	switch strings.ToLower(strings.TrimSpace(resp.Header.Get("Content-Encoding"))) {
+	case "gzip":
+		zr, err := gzip.NewReader(resp.Body)
+		if err != nil {
+			return nil, err
+		}
+		return zr, nil
+	case "deflate":
+		return flate.NewReader(resp.Body), nil
+	case "br":
+		return io.NopCloser(brotli.NewReader(resp.Body)), nil
+	case "zstd":
+		zr, err := zstd.NewReader(resp.Body)
+		if err != nil {
+			return nil, err
+		}
+		return zr.IOReadCloser(), nil
+	default:
+		return resp.Body, nil
+	}
+}
