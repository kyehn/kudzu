+++ b/internal/agent/compact_threshold_test.go
@@ -80,3 +80,34 @@ func TestAcceptCheckpointCandidateRules(t *testing.T) {
 		t.Fatalf("manual below trigger: %v", err)
 	}
 }
+
+// Overflow / must-free compaction is the last resort before the session
+// deadlocks on ErrCompactionRequired. A strictly smaller candidate that stays
+// above the maintenance trigger must still land (it frees room for the request
+// to go out) as long as it is below the physical hard ceiling.
+func TestAcceptCheckpointCandidateForceLandsAboveTrigger(t *testing.T) {
+	a := &Agent{agentConfig: agentConfig{contextWindow: 1_000_000, compactRatio: 0.85}}
+	trigger := a.compactTrigger() // 850_000
+	hard := a.hardInputCeiling()
+	// Forced candidate below trigger: accept (unchanged behavior).
+	if err := a.acceptCheckpointCandidate(CompactionTriggerOverflow, true, 900_000, 800_000, 50_000); err != nil {
+		t.Fatalf("forced candidate below trigger: %v", err)
+	}
+	// Forced candidate at/above trigger but below hard ceiling: accept —
+	// overflow must land a strictly smaller, physically feasible view.
+	if err := a.acceptCheckpointCandidate(CompactionTriggerOverflow, true, 900_000, 870_000, 50_000); err != nil {
+		t.Fatalf("forced candidate above trigger but below hard should land: %v", err)
+	}
+	_ = trigger
+	// Forced candidate at/above hard ceiling: still reject (no free room).
+	if hard > 0 {
+		if err := a.acceptCheckpointCandidate(CompactionTriggerOverflow, true, hard+10_000, hard, 50_000); err == nil {
+			t.Fatal("forced candidate at hard ceiling should reject")
+		}
+	}
+	// Non-force candidate above trigger must still be rejected.
+	if err := a.acceptCheckpointCandidate(CompactionTriggerPressure, false, 900_000, 870_000, 50_000); err == nil {
+		t.Fatal("non-force candidate above trigger should reject")
+	}
+}
