@@ -171,3 +171,34 @@ func TestStrictAlternatingRolesStillConvergesBeforeSampling(t *testing.T) {
 		}
 	}
 }
+
+// TestPrepareSamplingRecoversBuildCompactionFailure guards the resume path:
+// a Pressure build whose fold cannot land a candidate below the trigger —
+// hitting ErrCompactionRequired — must recover via overflow compaction instead
+// of stranding the turn. Without the recovery, prepareSamplingRequest returns
+// the error and the streamed turn is interrupted (the long-session deadlock
+// this fix removes). Sizing/recent-keep here make the forced candidate stay at
+// or above the trigger while remaining physically feasible.
+func TestPrepareSamplingRecoversBuildCompactionFailure(t *testing.T) {
+	big := strings.Repeat("word ", 500)
+	var msgs []provider.Message
+	msgs = append(msgs, provider.Message{Role: provider.RoleSystem, Content: "sys"})
+	for i := 0; i < 12; i++ {
+		msgs = append(msgs,
+			provider.Message{Role: provider.RoleUser, Content: "continue"},
+			provider.Message{Role: provider.RoleAssistant, Content: big},
+		)
+	}
+	sess := &Session{Messages: msgs}
+	a := New(&fakeProvider{streamErr: errors.New("summarizer down")}, tool.NewRegistry(), sess, Options{
+		ContextWindow: 1500, CompactRatio: 0.5, RecentKeep: 1, ArchiveDir: t.TempDir(),
+	}, event.Discard)
+
+	prepared, err := a.prepareSamplingRequest(context.Background())
+	if err != nil {
+		t.Fatalf("prepareSamplingRequest stranded the turn: %v", err)
+	}
+	if len(prepared.req.Messages) == 0 {
+		t.Fatal("prepareSamplingRequest returned an empty request")
+	}
+}
