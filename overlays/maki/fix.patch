+/// CLI wire identity for the opencode Zen free tier
+/// (`packages/schema/src/identifier.ts` + `session/llm/request.ts`):
+/// `msg_`/`ses_` + 12 lowercase hex time chars + 14 base62 chars. Packs
+/// `(now_ms << 12 | per_ms_counter)` with the counter starting at 1, exactly
+/// like upstream's `create()`; `ses_` inverts the packed value so it sorts
+/// newest-first, like `descending()`. One sequence shared by both prefixes,
+/// like upstream's single module-level counter.
+static OPENCODE_ID_SEQ: AtomicU64 = AtomicU64::new(0);
+
+/// The base62 tail alphabet (`identifier.ts` `chars`), also the set used to
+/// recognize CLI-shaped session ids.
+pub(crate) const OPENCODE_ID_ALPHABET: &[u8] =
+    b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+
+const OPENCODE_CLIENT_HEADER: &str = "x-opencode-client";
+const OPENCODE_PROJECT_HEADER: &str = "x-opencode-project";
+const OPENCODE_REQUEST_HEADER: &str = "x-opencode-request";
+const OPENCODE_SESSION_HEADER: &str = "x-opencode-session";
+
+fn opencode_random_tail(id: &mut String) {
+    let mut rand = [0u8; 14];
+    if getrandom::fill(&mut rand).is_err() {
+        for b in rand.iter_mut() {
+            *b = fastrand::u8(..);
+        }
+    }
+    for b in rand {
+        id.push(OPENCODE_ID_ALPHABET[(b % 62) as usize] as char);
+    }
+}
+
+fn opencode_id(prefix: &str, descending: bool) -> String {
+    let now_ms = SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0);
+    let mut seq = OPENCODE_ID_SEQ.load(Ordering::Relaxed);
+    seq = loop {
+        let next = if seq >> 12 == now_ms {
+            seq + 1
+        } else {
+            (now_ms << 12) | 1
+        };
+        match OPENCODE_ID_SEQ.compare_exchange_weak(seq, next, Ordering::Relaxed, Ordering::Relaxed)
+        {
+            Ok(_) => break next,
+            Err(cur) => seq = cur,
+        }
+    };
+    let packed = if descending { !seq } else { seq };
+    let mut id = String::with_capacity(30);
+    id.push_str(prefix);
+    for i in 0..6 {
+        id.push_str(&format!("{:02x}", ((packed >> (40 - 8 * i)) & 0xff) as u8));
+    }
+    opencode_random_tail(&mut id);
+    id
+}
+
+pub(crate) fn opencode_request_id() -> String {
+    opencode_id("msg_", false)
+}
+
+pub(crate) fn opencode_session_id() -> String {
+    opencode_id("ses_", true)
+}
+
+/// TLS 1.2 cipher suites from the opencode CLI capture
+/// (overlays/maki/opencode/tls-fingerprint.json), OpenSSL names in wire
+/// order. The fourteen suites land byte-identical to the capture; the backend
+/// keeps its own TLS 1.3 head order plus a trailing renegotiation SCSV, which
+/// curl's API surface cannot reorder (no TLS 1.3 cipher-list knob in
+/// isahc 1.8.3). ALPN already rides as http/1.1 via the pinned HTTP/1.1
+/// negotiation, matching the capture too. Extension/group/signature ordering
+/// stays the backend's own: strictly closer to the CLI, not JA3 parity.
+pub(crate) const OPENCODE_TLS12_CIPHERS: &[&str] = &[
+    "ECDHE-ECDSA-AES128-GCM-SHA256",
+    "ECDHE-RSA-AES128-GCM-SHA256",
+    "ECDHE-ECDSA-AES256-GCM-SHA384",
+    "ECDHE-RSA-AES256-GCM-SHA384",
+    "ECDHE-ECDSA-CHACHA20-POLY1305",
+    "ECDHE-RSA-CHACHA20-POLY1305",
+    "ECDHE-ECDSA-AES128-SHA",
+    "ECDHE-RSA-AES128-SHA",
+    "ECDHE-ECDSA-AES256-SHA",
+    "ECDHE-RSA-AES256-SHA",
+    "AES128-GCM-SHA256",
+    "AES256-GCM-SHA384",
+    "AES128-SHA",
+    "AES256-SHA",
+];
+
+/// Pin the opencode CLI TLS shape on Zen free-tier requests. No-op for every
+/// other provider: the pin is per-request, never on the shared client, so a
+/// Zen request cannot leak its fingerprint onto unrelated providers.
+pub(crate) fn opencode_tls(auth: &ResolvedAuth, builder: Builder) -> Builder {
+    if auth.opencode_wire {
+        builder.ssl_ciphers(OPENCODE_TLS12_CIPHERS.iter().copied())
+    } else {
+        builder
+    }
+}
+
+/// Custom zen-wire slugs live outside the builtin flow: any custom provider
+/// pointed at the zen gateway gets the CLI wire identity by path match, so
+/// renames — and local forward proxies to the real gateway — keep working
+/// (the gateway still checks the headers; a fake just ignores them). The go
+/// gateway (`/zen/go`) is a different product and never matches.
+pub(crate) fn is_zen_base_url(url: Option<&str>) -> bool {
+    let Some(u) = url else { return false };
+    (u.contains("/zen/") || u.ends_with("/zen")) && !u.contains("/zen/go")
+}
+
+/// CLI session ids are `ses_` + 12 hex + 14 base62 chars
+/// (`identifier.ts` `create(descending)`). Anything else — maki's base58
+/// nanoID, or a bare string — is not a CLI session id.
+fn is_cli_session_id(s: &str) -> bool {
+    let Some(rest) = s.strip_prefix("ses_") else {
+        return false;
+    };
+    if rest.len() != 26 {
+        return false;
+    }
+    let (hex, tail) = rest.split_at(12);
+    hex.bytes().all(|b| b.is_ascii_hexdigit())
+        && tail.bytes().all(|b| OPENCODE_ID_ALPHABET.contains(&b))
+}
