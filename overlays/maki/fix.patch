+/// Ascending opencode request IDs (`msg_` + 12 hex time chars + 14 base62
+/// chars), mirroring `packages/schema/src/identifier.ts`. Packs
+/// `(now_ms << 12 | per_ms_counter)` so concurrent requests stay unique.
+static OPENCODE_REQUEST_SEQ: AtomicU64 = AtomicU64::new(0);
+
+/// Descending opencode session IDs (`ses_`), same shape as `msg_` but with
+/// the ~current encoding opencode uses for session IDs. The Zen free tier
+/// rejects non-CLI session shapes (proven live: `ses_<12hex><14b62>` 200,
+/// bare/maki-nanoID 403), so the wire always carries a CLI session id.
+static OPENCODE_SESSION_SEQ: AtomicU64 = AtomicU64::new(0);
+
+const OPENCODE_ID_CHARS: &[u8] = b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+
+/// The base62 alphabet as a set/slice for validating CLI session shapes
+/// (split_at(12) hex + 14 base62 tail in mod.rs).
+pub(crate) const OPENCODE_ID_B62: &[u8] = OPENCODE_ID_CHARS;
+
+fn opencode_random_bytes(buf: &mut [u8]) {
+    if let Ok(mut f) = std::fs::File::open("/dev/urandom") {
+        use std::io::Read;
+        if f.read_exact(buf).is_ok() {
+            return;
+        }
+    }
+    // Uniqueness still rides on the time/counter prefix; this is only entropy.
+    let mut x = SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(0x2545_f491_4f6c_dd1d)
+        | 1;
+    for b in buf.iter_mut() {
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        *b = (x & 0xff) as u8;
+    }
+}
+
+pub(crate) fn opencode_request_id() -> String {
+    cli_id("msg_", false)
+}
+
+/// A fresh CLI-shaped `ses_` session id for the Zen free tier. The gateway
+/// rejects a missing or non-CLI session header (403 FreeTierError before any
+/// provider call), so every zen request gets a real one even when maki's own
+/// session ref (base58 nanoID) wouldn't pass. Not tied to the maki session:
+/// a fresh id per request matches the captures (each `opencode run` carries a
+/// fresh ses_) and the gateway only checks the shape.
+pub(crate) fn opencode_session_id() -> String {
+    cli_id("ses_", true)
+}
+
+fn cli_id(prefix: &str, descending: bool) -> String {
+    let now_ms = SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0);
+    let mut seq = if descending {
+        OPENCODE_SESSION_SEQ.load(Ordering::Relaxed)
+    } else {
+        OPENCODE_REQUEST_SEQ.load(Ordering::Relaxed)
+    };
+    seq = loop {
+        let next = if seq >> 12 == now_ms {
+            seq + 1
+        } else {
+            now_ms << 12
+        };
+        let updated = if descending {
+            OPENCODE_SESSION_SEQ.compare_exchange_weak(
+                seq,
+                next,
+                Ordering::Relaxed,
+                Ordering::Relaxed,
+            )
+        } else {
+            OPENCODE_REQUEST_SEQ.compare_exchange_weak(
+                seq,
+                next,
+                Ordering::Relaxed,
+                Ordering::Relaxed,
+            )
+        };
+        match updated {
+            Ok(_) => break next,
+            Err(cur) => seq = cur,
+        }
+    };
+    // Descending ids invert the packed value so they sort newest-first,
+    // mirroring opencode's `create(descending)`.
+    let packed = if descending { !seq } else { seq };
+    let mut id = String::with_capacity(30);
+    id.push_str(prefix);
+    for i in 0..6 {
+        id.push_str(&format!("{:02x}", ((packed >> (40 - 8 * i)) & 0xff) as u8));
+    }
+    let mut rand = [0u8; 14];
+    opencode_random_bytes(&mut rand);
+    for b in rand {
+        id.push(OPENCODE_ID_CHARS[(b % 62) as usize] as char);
+    }
+    id
+}
