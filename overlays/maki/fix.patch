+/// TLS 1.2 cipher suites from the opencode CLI capture
+/// (overlays/maki/opencode/tls-fingerprint.json), OpenSSL names in wire
+/// order. Measured effect (local ClientHello probe, /tmp/tlsprobe): the
+/// fourteen suites land byte-identical to the capture; the backend keeps its
+/// own TLS 1.3 head order plus a trailing renegotiation SCSV, which curl's
+/// API surface cannot reorder (no TLS 1.3 cipher-list knob in isahc 1.8.3).
+/// ALPN already rides as http/1.1 via the pinned HTTP/1.1 negotiation,
+/// matching the capture too. Extension/group/signature ordering stays the
+/// backend's own (bun explicitly enables SCT/OCSP extensions and BoringSSL
+/// shapes the rest -- see the bun source study in overlays/maki/README.md):
+/// strictly closer to the CLI, not JA3 parity.
+pub(crate) const OPENCODE_TLS12_CIPHERS: &[&str] = &[
+    "ECDHE-ECDSA-AES128-GCM-SHA256",
+    "ECDHE-RSA-AES128-GCM-SHA256",
+    "ECDHE-ECDSA-AES256-GCM-SHA384",
+    "ECDHE-RSA-AES256-GCM-SHA384",
+    "ECDHE-ECDSA-CHACHA20-POLY1305",
+    "ECDHE-RSA-CHACHA20-POLY1305",
+    "ECDHE-ECDSA-AES128-SHA",
+    "ECDHE-RSA-AES128-SHA",
+    "ECDHE-ECDSA-AES256-SHA",
+    "ECDHE-RSA-AES256-SHA",
+    "AES128-GCM-SHA256",
+    "AES256-GCM-SHA384",
+    "AES128-SHA",
+    "AES256-SHA",
+];
+
+/// Pin the opencode CLI TLS shape on Zen free-tier requests. No-op for every
+/// other provider: the pin is per-request, never on the shared client, so a
+/// Zen request cannot leak its fingerprint onto unrelated providers.
+pub(crate) fn opencode_tls(auth: &ResolvedAuth, builder: Builder) -> Builder {
+    if auth.opencode_wire {
+        builder.ssl_ciphers(OPENCODE_TLS12_CIPHERS.iter().copied())
+    } else {
+        builder
+    }
+}
+
+/// Custom zen-wire slugs live outside the builtin flow (see
+/// overlays/maki/README.md): any custom provider pointed at the zen gateway
+/// gets the CLI wire identity by base URL match, so renames keep working.
+/// The go gateway (`/zen/go`) is a different product and never matches.
+pub(crate) fn is_zen_base_url(url: Option<&str>) -> bool {
+    url.is_some_and(|u| u.contains("opencode.ai/zen") && !u.contains("/zen/go"))
+}
+
+/// Stamp the CLI wire identity: static client tag, fresh ascending msg_
+/// request ID per call, and a CLI-shaped `ses_` session ID.
+///
+/// The session param is a *maki* session ref (base58 nanoID) which the Zen
+/// free tier rejects; when provided we keep using it only if it is already
+/// CLI-shaped (`ses_` + 12 hex + 14 base62), otherwise we mint a fresh CLI
+/// `ses_`. The gateway checks the header shape, not the value (live proof:
+/// `ses_<12hex><14b62>` 200, maki nanoID 403), so a fresh id per request is
+/// safe and matches the captures (each `opencode run` brings a fresh ses_).
+/// Idempotent (`set_header` replaces), so sharing it between the builtin
+/// choke point and the custom path cannot double-stamp.
+pub(crate) fn apply_zen_wire_identity(auth: &mut ResolvedAuth, session: Option<String>) {
+    auth.set_header("x-opencode-client", "cli".into());
+    auth.set_header("x-opencode-request", catalog::opencode_request_id());
+    let session = session.filter(|s| is_cli_session_id(s));
+    auth.set_header(
+        "x-opencode-session",
+        session.unwrap_or_else(catalog::opencode_session_id),
+    );
+    auth.opencode_wire = true;
+}
+
+/// CLI session ids are `ses_` + 12 lowercase hex + 14 base62 chars
+/// (packages/schema/src/identifier.ts create(descending)). Anything else —
+/// maki's base58 nanoID, or a bare string — is not a CLI session id.
+fn is_cli_session_id(s: &str) -> bool {
+    let Some(rest) = s.strip_prefix("ses_") else {
+        return false;
+    };
+    if rest.len() != 26 {
+        return false;
+    }
+    let (hex, tail) = rest.split_at(12);
+    hex.chars().all(|c| c.is_ascii_hexdigit())
+        && tail.bytes().all(|b| catalog::OPENCODE_ID_B62.contains(&b))
+}
