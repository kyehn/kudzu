# Disable the default DeepSeek models (this deployment serves opencode zen
# free models instead; the DeepSeek rows would advertise unreachable models)
# and the DeepSeek web search provider (it needs a real DEEPSEEK_API_KEY this
# deployment does not hold); default the ACP bridge to the zen route so the
# model selector and agent options read a defined initial route.
# Applies to deepseekharness-acp-interactive config/cordis.yml.
--- a/config/cordis.yml
+++ b/config/cordis.yml
@@ -3,23 +3,7 @@
 - id: llm-deepseek
   name: '@deepseek-ai/dsh-llm-deepseek-api-key'
   config:
-    thinking: enabled
-    reasoningEffort: max
-    # The official directory is V4.1 Flash and V4 Pro. The retired
-    # `deepseek-v4-flash-vision-exp` beta is deliberately absent: advertising it
-    # offers a route the service no longer serves. Flash is the image-capable
-    # entry, so it declares its modalities.
-    models:
-      - id: deepseek-flash
-        name: DeepSeek V4.1 Flash
-        contextWindow: 1000000
-        maxTokens: 384000
-        inputModalities: [text, image]
-      - id: deepseek-v4-pro
-        name: DeepSeek V4 Pro
-        contextWindow: 1000000
-        maxTokens: 384000
-        inputModalities: [text]
+    models: []
 - id: credentials
   name: '@deepseek-ai/dsh-credentials-local'
 - id: llm-pi-ai
@@ -219,6 +203,7 @@
   name: '@deepseek-ai/dsh-web'
 - id: web-search-deepseek
   name: '@deepseek-ai/dsh-web-search-deepseek'
+  disabled: true
 - id: web-fetch-http
   name: '@deepseek-ai/dsh-web-fetch-http'
 - id: tool-web
@@ -260,5 +245,5 @@
 - id: acp-interactive
   name: '../lib/index.js'
   config:
-    provider: deepseek-official
-    model: deepseek-v4-pro
+    provider: opencode-openai
+    model: mimo-v2.6-flash-free
