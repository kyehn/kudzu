# TLS ClientHello 对齐基准：overlays/reasonix/opencode/_tls-fingerprint.json
# （opencode CLI v1.18.18 / Bun / BoringSSL 真实抓包）。
#
# 本文件只负责 Node 侧无法通过其他 API 控制的唯一维度：
#   - SignatureAlgorithms：signature_algorithms 扩展的顺序与集合。
#     配置基准 9 项（ecdsa_secp256r1_sha256 / rsa_pss_rsae_sha256 /
#     rsa_pkcs1_sha256 / ecdsa_secp384r1_sha384 / rsa_pss_rsae_sha384 /
#     rsa_pkcs1_sha384 / rsa_pss_rsae_sha512 / rsa_pkcs1_sha512 /
#     rsa_pkcs1_sha1）。实测（node 22/24 与 openssl s_client 3.0.13 一致）：
#     OpenSSL 3.x 在 ClientHello 中过滤 rsa_pkcs1_sha1(0201)——无论
#     security level 或 provider 如何配置均不发出（已用 s_client
#     -security_level 0 验证），故实际发出 8 项：
#       0403 0804 0401 0503 0805 0501 0806 0601
#     与基准前 8 项逐字节一致；0201 缺席为 OpenSSL 硬限制，如实记录
#     （断言测试同样只断言可达维度，见 opencode-tls.test.mjs）。
#
# 其余维度由 opencode-sim.mjs 的 undici connect 参数控制（唯一事实源，
# 实测 Node 的 SSL_CTX 显式设置会覆盖 config，故不在此重复配置）：
#   - TLS 1.2/1.3 cipher 顺序：connect.ciphers（Node 显式设置 cipher list，
#     config 的 CipherString/CipherSuites 不生效）
#   - supported_groups 顺序：connect.ecdhCurve（同样覆盖 config 的 Groups）
#   - 协议版本范围：connect.minVersion/maxVersion（Node 硬编码 TLS 1.2 下限）
#   - ALPN http/1.1：connect 的 ALPNProtocols
#
# ClientHello 扩展的线序（extended_master_secret / renegotiation_info /
# status_request / SCT / encrypt_then_mac 等的位置）由 OpenSSL 硬编码、
# 无法配置，与 BoringSSL 基准存在如实记录的差异——见
# opencode-sim/opencode-tls.test.mjs 的断言测试，该测试逐项断言可配置维度
# 与基准一致，并如实报告扩展线序差异（不虚报）。
#
# 注意：Node 初始化 OpenSSL 时把 config appname 设为 "nodejs_conf"
# （src/node.cc OPENSSL_INIT_set_config_appname），故顶层段必须叫
# nodejs_conf 而非 openssl_conf，否则 --openssl-config 静默不生效。
nodejs_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
SignatureAlgorithms = ecdsa_secp256r1_sha256:rsa_pss_rsae_sha256:rsa_pkcs1_sha256:ecdsa_secp384r1_sha384:rsa_pss_rsae_sha384:rsa_pkcs1_sha384:rsa_pss_rsae_sha512:rsa_pkcs1_sha512:rsa_pkcs1_sha1