# Register a settings-driven "mcp" section (name-keyed stdio/HTTP server
# entries) and fall back to it when a session requests no MCP servers:
# paseo's ACP client always sends `mcpServers: []`, so deployment MCP
# servers would never reach a session otherwise. Applies to
# deepseekharness-acp-interactive lib/index.js (settings section
# registration in apply() + pickMcpServers at both session call sites).
--- a/lib/index.js
+++ b/lib/index.js
@@ -1327,7 +1327,40 @@
 const Config = Schema.object({
 	provider: Schema.string(),
 	model: Schema.string()
 });
+/** Settings namespace carrying deployment MCP servers for sessions that request none. */
+const MCP_SETTINGS_NAMESPACE = "mcp";
+/** Settings schema: name-keyed stdio or HTTP MCP server entries. */
+const MCP_SETTINGS_SCHEMA = Schema.dict(Schema.union([
+	Schema.object({
+		type: Schema.const("http").required(),
+		url: Schema.string().required(),
+		headers: Schema.dict(Schema.string()).default({})
+	}),
+	Schema.object({
+		command: Schema.string().required(),
+		args: Schema.array(Schema.string()).default([]),
+		env: Schema.dict(Schema.string()).default({})
+	})
+]));
+/**
+* Convert one resolved settings section into the ACP server list shape.
+* @param section - name-keyed MCP entries resolved from settings.
+* @returns one ACP MCP configuration per settings entry.
+*/
+function configuredMcpServers(section) {
+	return Object.entries(section).map(([name, entry]) => entry.type === "http" ? {
+		name,
+		type: "http",
+		url: entry.url,
+		headers: Object.entries(entry.headers).map(([key, value]) => ({ name: key, value }))
+	} : {
+		name,
+		command: entry.command,
+		args: [...entry.args],
+		env: Object.entries(entry.env).map(([key, value]) => ({ name: key, value }))
+	});
+}
