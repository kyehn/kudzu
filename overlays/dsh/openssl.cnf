# OpenSSL configuration that aligns Node's TLS cipher preference with the
# BoringSSL defaults used by the opencode CLI (Bun embeds BoringSSL).
#
# Scope and honesty:
# - Cipher *order* (JA3) is aligned: BoringSSL prefers CHACHA20 over AES-GCM
#   for TLS 1.2, and orders TLS 1.3 suites AES-128-GCM > AES-256-GCM > CHACHA20.
# - The TLS version floor (1.2) matches BoringSSL's default minimum.
# - Extension order and ClientHello details are decided inside OpenSSL and
#   cannot be byte-for-byte replicated; JA3 length may differ slightly.
# - Group preference (X25519 first) already matches BoringSSL in OpenSSL.
#
# Loaded by the `dsh` wrapper via NODE_OPTIONS=--openssl-config=...

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.3
# BoringSSL TLS 1.2 order (kDefaultCiphers): CHACHA20 first, then AES-GCM.
CipherString = ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-CCM:ECDHE-ECDSA-AES256-CCM:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384
# BoringSSL TLS 1.3 order: AES-128-GCM, AES-256-GCM, CHACHA20.
Ciphersuites = TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
