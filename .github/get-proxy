#!/usr/bin/env bash

set -euo pipefail

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

curl -sL https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/http.txt \
  | sed 's#^#http://#' > "$WORK/monosans.txt"
curl -sL https://raw.githubusercontent.com/proxifly/free-proxy-list/main/proxies/protocols/http/data.txt > "$WORK/proxifly.txt"
cat "$WORK/monosans.txt" "$WORK/proxifly.txt" | sort -u > "$WORK/all.txt"

python - "$WORK/all.txt" "$WORK/shuffled.txt" << 'PY'
import random, sys
lines = open(sys.argv[1]).read().splitlines()
random.shuffle(lines)
open(sys.argv[2], "w").write("\n".join(lines) + "\n")
PY

python3 - "$WORK/shuffled.txt" << 'PY'
import concurrent.futures, requests, sys

cands = [l.strip() for l in open(sys.argv[1]) if l.strip()]
seen = set()
uniq = [c for c in cands if not (c in seen or seen.add(c))]

def ok(proxy):
    proxies = {"http": proxy, "https": proxy}
    for _ in range(2):
        try:
            response = requests.get(
                "https://httpbin.org/ip", proxies=proxies, timeout=6
            )
            if response.status_code != 200 or "origin" not in response.text:
                return None
        except Exception:
            return None
    return proxy

with concurrent.futures.ThreadPoolExecutor(max_workers=48) as executor:
    futures = {executor.submit(ok, proxy): proxy for proxy in uniq}
    for future in concurrent.futures.as_completed(futures):
        result = future.result()
        if result:
            print(result)
            for pending in futures:
                pending.cancel()
            break
PY
