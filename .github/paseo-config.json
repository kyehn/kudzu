{
	"$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
	"version": 1,
	"agents": {
		"providers": {
			"maki": {
				"extends": "acp",
				"label": "Maki",
				"command": ["maki", "acp", "--yolo"]
			},
			"reasonix": {
				"extends": "acp",
				"label": "Reasonix",
				"command": ["reasonix", "acp"]
			},
			"omp": {
				"enabled": false
			},
			"copilot": {
				"enabled": false
			},
			"codex": {
				"enabled": false
			},
			"opencode": {
				"enabled": false
			},
			"claude": {
				"enabled": false
			}
		}
	},
	"daemon": {
		"enableTerminalAgentHooks": false,
		"relay": {
			"enabled": true
		},
		"mcp": {
			"enabled": false,
			"injectIntoAgents": false
		}
	},
	"features": {
		"webUi": {
			"enabled": false
		}
	}
}
