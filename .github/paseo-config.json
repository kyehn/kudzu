{
	"$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
	"version": 1,
	"pluginsEnabled": true,
	"agents": {
		"providers": {
			"maki": {
				"extends": "acp",
				"label": "Maki",
				"command": [
					"systemd-run",
					"--user",
					"--scope",
					"-p",
					"MemoryMax=7G",
					"-p",
					"TasksMax=512",
					"--",
					"nice",
					"-n",
					"10",
					"maki",
					"acp",
					"--yolo"
				]
			},
			"reasonix": {
				"extends": "acp",
				"label": "Reasonix",
				"command": [
					"systemd-run",
					"--user",
					"--scope",
					"-p",
					"MemoryMax=7G",
					"-p",
					"TasksMax=512",
					"--",
					"nice",
					"-n",
					"10",
					"reasonix",
					"acp"
				]
			},
			"opencode": {
				"command": [
					"systemd-run",
					"--user",
					"--scope",
					"-p",
					"MemoryMax=7G",
					"-p",
					"TasksMax=512",
					"--",
					"nice",
					"-n",
					"10",
					"opencode"
				]
			},
			"pi": {
				"enabled": false
			},
			"antigravity": {
				"enabled": false
			},
			"muse": {
				"enabled": false
			},
			"omp": {
				"enabled": false
			},
			"copilot": {
				"enabled": false
			},
			"codex": {
				"enabled": false
			},
			"claude": {
				"enabled": false
			}
		}
	},
	"daemon": {
		"enableTerminalAgentHooks": false,
		"relay": {
			"enabled": true
		},
		"mcp": {
			"enabled": false,
			"injectIntoAgents": false
		}
	},
	"features": {
		"webUi": {
			"enabled": false
		},
		"voiceMode": {
			"enabled": false
		},
		"dictation": {
			"enabled": false
		}
	}
}
