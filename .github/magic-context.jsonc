{
    // Consumed by @cortexkit/pi-magic-context via ~/.config/cortexkit/magic-context.jsonc
    // (see .github/workflows/paseo.yml). Only OpenCode/Pi harnesses read this file;
    // reasonix does its own context maintenance (overlays/reasonix-config.nix).
    // auto_drop_tool_age / nudge_interval_tokens were removed upstream in v0.23.0
    // (tiered emergency drop + ctx_reduce replaced them); do not re-add.
    "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
    "enabled": true,
    "history_budget_percentage": 0.1,
    "execute_threshold_percentage": 45,
    "cache_ttl": "3m",
    "clear_reasoning_age": 25,
    "protected_tags": 10,
    "historian": {
        "temperature": 0.1
    },
    "dreamer": {
        "disable": true
    },
    "sidekick": {
        "enabled": true
    },
    "embedding": {
        "provider": "off"
    },
    "memory": {
        "enabled": false,
        "auto_search": {
            "enabled": false
        }
    }
}