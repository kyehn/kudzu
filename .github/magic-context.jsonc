{
	"$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
	"language": "zh",
	"auto_update": false,
	"historian": {
		"disable": true
	},
	"dreamer": {
		"disable": true
	},
	"embedding": {
		"provider": "off"
	},
	"memory": {
		"enabled": false,
		"auto_search": {
			"enabled": false
		}
	}
}
