{
	"language": "简体中文",
	"permissions": {
		"defaultMode": "bypassPermissions",
		"allow": ["Bash(npm run lint)", "Bash(npm run test:*)", "Read(~/.zshrc)"],
		"ask": ["Bash(git push:*)"],
		"deny": [
			"Bash(curl:*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)"
		]
	},
	"env": {
		"NODE_ENV": "development",
		"DEBUG": "codebuddy:*"
	},
	"cleanupPeriodDays": 7,
	"includeCoAuthoredBy": false,
	"sandbox": {
		"enabled": false
	},
	"reasoningEffort": "max",
	"trustAll": true,
	"memory": {
		"autoMemoryEnabled": false
	},
	"gateway": {
		"auth": "none",
		"corsOrigins": ["https://*.trycloudflare.com"]
	}
}
